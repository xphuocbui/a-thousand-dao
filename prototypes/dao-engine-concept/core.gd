# PROTOTYPE - NOT FOR PRODUCTION
# Question: Does drafting/fusing fragments into a chain engine make players rework builds, and can a local LLM narrate it within engine budgets?
# Date: 2026-11-02
extends RefCounted

# Dao engine core: fragments, chain simulation, fusion, enemies. Pure logic, no UI.

const ROUNDS := 5
const MAX_SLOTS := 6
# Five-element generation cycle: each element generates the next one.
const ELEMENTS := ["wood", "fire", "earth", "metal", "water"]

# One enemy per stage; the last is the tribulation. HP tuned with sim.gd.
const ENEMIES := [
	{"name": "Rogue Disciple", "hp": 140.0},
	{"name": "Sect Elder", "hp": 450.0},
	{"name": "Heavenly Tribulation", "hp": 950.0},
]

# kind: strike | amp | echo_elem | grow | synergy | combo
# dmg = base value, param = kind-specific (amp multiplier, growth per round, ...)
const POOL := [
	{"name": "Ember Palm", "elem": "fire", "kind": "strike", "dmg": 12.0, "param": 0.0, "desc": "hits for 12"},
	{"name": "Stone Skin Fist", "elem": "earth", "kind": "strike", "dmg": 14.0, "param": 0.0, "desc": "hits for 14"},
	{"name": "Frost Needle", "elem": "water", "kind": "strike", "dmg": 10.0, "param": 0.0, "desc": "hits for 10"},
	{"name": "Thorn Vine", "elem": "wood", "kind": "strike", "dmg": 9.0, "param": 0.0, "desc": "hits for 9"},
	{"name": "Iron Edge", "elem": "metal", "kind": "strike", "dmg": 13.0, "param": 0.0, "desc": "hits for 13"},
	{"name": "Qi Gathering", "elem": "wood", "kind": "amp", "dmg": 0.0, "param": 1.6, "desc": "all later slots x1.6"},
	{"name": "Mountain Seal", "elem": "earth", "kind": "amp", "dmg": 0.0, "param": 1.5, "desc": "all later slots x1.5"},
	{"name": "Flame Echo", "elem": "fire", "kind": "echo_elem", "dmg": 10.0, "param": 0.0, "desc": "10 per earlier same-element slot"},
	{"name": "Heavenly Furnace", "elem": "fire", "kind": "grow", "dmg": 6.0, "param": 6.0, "desc": "6, +6 each round"},
	{"name": "Resonant Bell", "elem": "metal", "kind": "synergy", "dmg": 8.0, "param": 1.0, "desc": "8, +100% per other same-element slot"},
	{"name": "Flowing Stream", "elem": "water", "kind": "combo", "dmg": 8.0, "param": 3.0, "desc": "8, x3 if previous slot generates water"},
	{"name": "Nine Turn Pill", "elem": "wood", "kind": "grow", "dmg": 4.0, "param": 8.0, "desc": "4, +8 each round"},
]


func generates(a_elem: String, b_elem: String) -> bool:
	return ELEMENTS.find(b_elem) == (ELEMENTS.find(a_elem) + 1) % ELEMENTS.size()


func draw_offers(rng: RandomNumberGenerator, count: int = 3) -> Array:
	var idx: Array = range(POOL.size())
	var out: Array = []
	for n in count:
		var pick: int = rng.randi_range(0, idx.size() - 1)
		out.append(POOL[idx[pick]].duplicate())
		idx.remove_at(pick)
	return out


# Fusion is rule-based, not a pair table: the stronger fragment dominates,
# the weaker lends 75% of its base and 50% of its param when the kinds match.
func fuse(a: Dictionary, b: Dictionary) -> Dictionary:
	var a_weight: float = a.dmg + a.param * 3.0
	var b_weight: float = b.dmg + b.param * 3.0
	var dom: Dictionary = a if a_weight >= b_weight else b
	var oth: Dictionary = b if a_weight >= b_weight else a
	var f: Dictionary = dom.duplicate()
	f["dmg"] = dom.dmg + oth.dmg * 0.75
	if dom.kind == oth.kind:
		f["param"] = dom.param + oth.param * 0.5 if dom.kind != "amp" else dom.param * oth.param
	var first: String = String(dom.name).split(" ")[0]
	var last: String = String(oth.name).split(" ")[-1]
	f["name"] = "%s-%s" % [first, last]
	f["desc"] = "fused: %.0f base, param %.1f" % [f.dmg, f.param]
	return f


# Run a clash. rng == null gives the expected (no dice) result used for previews.
# Returns {total, per_slot[], lines[]}.
func simulate(build: Array, rng: RandomNumberGenerator = null) -> Dictionary:
	var total: float = 0.0
	var lines: Array = []
	var per_slot: Array = []
	per_slot.resize(build.size())
	per_slot.fill(0.0)
	for r in range(1, ROUNDS + 1):
		var carry: float = 1.0
		for i in build.size():
			var f: Dictionary = build[i]
			var raw: float = 0.0
			var note: String = ""
			match f.kind:
				"strike":
					raw = f.dmg
				"amp":
					carry *= f.param
					lines.append({"round": r, "slot": i, "name": f.name, "dealt": 0.0, "note": "amplifies all later slots x%.2f" % f.param})
					continue
				"echo_elem":
					var n: int = 0
					for j in i:
						if build[j].elem == f.elem:
							n += 1
					raw = f.dmg * n
					note = "%d earlier %s slot(s)" % [n, f.elem]
				"grow":
					raw = f.dmg + f.param * (r - 1)
					note = "grown to %.0f" % raw
				"synergy":
					var n2: int = 0
					for j in build.size():
						if j != i and build[j].elem == f.elem:
							n2 += 1
					raw = f.dmg * (1.0 + f.param * n2)
					note = "%d other %s slot(s)" % [n2, f.elem]
				"combo":
					raw = f.dmg
					if i > 0 and generates(build[i - 1].elem, f.elem):
						raw *= f.param
						note = "generated by %s" % build[i - 1].name
			var roll: float = 1.0 if rng == null else rng.randf_range(0.9, 1.1)
			var dealt: float = raw * carry * roll
			if carry != 1.0:
				note += (" " if note != "" else "") + "amped x%.2f" % carry
			total += dealt
			per_slot[i] += dealt
			lines.append({"round": r, "slot": i, "name": f.name, "dealt": dealt, "note": note})
	return {"total": total, "per_slot": per_slot, "lines": lines}


# Templated narration: the always-available fallback. The engine decided;
# this text only dresses the numbers.
func narrate_template(result: Dictionary, enemy: Dictionary, won: bool) -> String:
	var best: Dictionary = {"dealt": -1.0, "name": "", "round": 0}
	for l in result.lines:
		if l.dealt > best.dealt:
			best = l
	var s: String = "You unleash your Dao against the %s. " % enemy.name
	s += "Your strongest strike, %s in round %d, lands for %.0f. " % [best.name, best.round, best.dealt]
	s += "In total you deal %.0f against %.0f. " % [result.total, enemy.hp]
	s += "The %s falls." % enemy.name if won else "The %s endures, and your Dao is not yet enough." % enemy.name
	return s
