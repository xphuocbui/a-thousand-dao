; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; run/main_scene is intentionally unset: no scene exists yet.
; /dev-story or the developer sets it once a scene exists.

config_version=5

[application]

config/name="Ten Thousand Daos"
config/features=PackedStringArray("4.7", "Forward Plus")
; Only builds with the combat_bench feature (export preset "Windows Combat Bench") start here: the combat
; timing spike, tests/performance/combat/combat_bench.gd (ADR-0001). The game itself still has no main scene.
run/main_scene.combat_bench="res://tests/performance/combat/combat_bench.tscn"

[display]

; Fullscreen by default (user 2026-11-24: "let's just do fullscreen always"); test and dev runs pass --windowed.
; The UI's scaling (design/ux/hud.md Scaling rule, UiScale) is set by the map screen at run time, not here.
window/size/mode=3

[rendering]

renderer/rendering_method="forward_plus"
