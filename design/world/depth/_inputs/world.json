{
"_doc": "World context for every depth writer. start_year = the game's first year.",
"start_year": 1200,
"eras": [
{
"from": 0,
"to": 119,
"name": "The Wild Age",
"name_hv": "Hoang Kỷ",
"name_han": "荒紀",
"gist": "Hermits and beasts. Cửu Thiều Cung (70) is the only sect."
},
{
"from": 120,
"to": 339,
"name": "The Age of First Gates",
"name_hv": "Khai Môn Kỷ",
"name_han": "開門紀",
"gist": "Thiên Xu and the first great sects open their gates; Thiên Xu claims the heart of the continent. Ends with the War of the Nine Shao, Thiên Xu's first judgement."
},
{
"from": 340,
"to": 509,
"name": "The Age of Seven Seats",
"name_hv": "Thất Tọa Kỷ",
"name_han": "七座紀",
"gist": "The other great sects are founded and grab land; three old sects end. Ends when Tùng Đào and Lạc Hà try to take the heart and lose the War of the Pivot."
},
{
"from": 510,
"to": 789,
"name": "The Age of the North Star Compact",
"name_hv": "Bắc Thần Kỷ",
"name_han": "北辰紀",
"gist": "Land changes hands only by a fall, a gift, an oath or a war licensed by Thiên Xu's writ. Thiên Xu enforces the Compact."
},
{
"from": 790,
"to": 805,
"name": "The War of Broken Halberds",
"name_hv": "Chiết Kích Chi Chiến",
"name_han": "折戟之戰",
"gist": "Lạc Hà and Thính Vũ break the Compact together; Thiên Xu wins at the cost of its marshal, and the 805 truce renews the Compact."
},
{
"from": 806,
"to": 1200,
"name": "The Age of Vein Wars",
"name_hv": "Tranh Mạch Kỷ",
"name_han": "爭脈紀",
"gist": "No sect dares an open war of conquest; neighbours fight short wars over the wild veins near their borders, and Thiên Xu ends or decides them."
}
],
