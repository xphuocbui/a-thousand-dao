{
 "_doc": "Lê Hoa Am's Effect engine records (world-depth Stage 6; ADR-0009). Staged for tools/design/combat_sim/put_effects.py under source world-depth:le_hoa. Unpriced. Rule text from design/world/depth/sects/le_hoa.items.json.",
 "source": "world-depth:le_hoa",
 "effects": {
  "Toll of the Frozen Bolt": {
   "rule": "Bell of the Frozen Bolt (authored wish a1): every fifth Winter Toll Canon art you cast rings the bell: the foe gains 2 Ice stacks (8 s), and its clock stops for 0.5 s so arts coming ready in that half-second wait until it ends.",
   "counters": [
    {
     "id": "bell_toll"
    }
   ],
   "records": [
    {
     "id": "eff:Toll of the Frozen Bolt count",
     "on": "art_fired",
     "filter": {
      "group": "winter-toll-canon"
     },
     "do": [
      {
       "counter": {
        "id": "bell_toll",
        "add": 1
       }
      }
     ]
    },
    {
     "id": "eff:Toll of the Frozen Bolt ring",
     "on": "art_fired",
     "filter": {
      "group": "winter-toll-canon"
     },
     "if": [
      {
       "read": "own.counter.bell_toll",
       "op": ">=",
       "value": 5
      }
     ],
     "do": [
      {
       "counter": {
        "id": "bell_toll",
        "set": 0
       }
      },
      {
       "stacks": {
        "el": "ice",
        "n": 2,
        "for": 8,
        "side": "foe"
       }
      },
      {
       "stop_clock": {
        "side": "foe",
        "seconds": 0.5
       }
      }
     ]
    }
   ]
  },
  "Until It Stops Wanting": {
   "rule": "Pear-Blossom Vigil, full set (3 pieces): each Winter Toll Canon art you cast while the foe is held by your Frost Seal (seal_hold, Heavy Breath, or Slowed Time) makes the seal hold last 1 s longer, and reduces damage the foe deals by 5 % (dampen_taken 5.26) for 10 s; the tolls stack with no ceiling, and each fades on its own.",
   "counters": [
    {
     "id": "seal_hold",
     "decay_per_pulse": 1
    },
    {
     "id": "vigil_toll",
     "each_for": 10
    }
   ],
   "records": [
    {
     "id": "eff:Until It Stops Wanting toll",
     "on": "art_fired",
     "filter": {
      "group": "winter-toll-canon"
     },
     "if": [
      {
       "any": [
        {
         "read": "own.counter.seal_hold",
         "op": ">=",
         "value": 1
        },
        {
         "read": "foe.status.heavy_breath",
         "op": ">=",
         "value": 1
        },
        {
         "read": "foe.status.slowed_time",
         "op": ">=",
         "value": 1
        }
       ]
      }
     ],
     "do": [
      {
       "counter": {
        "id": "seal_hold",
        "add": 1
       }
      },
      {
       "counter": {
        "id": "vigil_toll",
        "add": 1
       }
      }
     ]
    },
    {
     "id": "eff:Until It Stops Wanting damp",
     "on": "always",
     "if": [
      {
       "read": "own.counter.vigil_toll",
       "op": ">=",
       "value": 1
      }
     ],
     "scale": {
      "read": "own.counter.vigil_toll",
      "per": 1
     },
     "do": [
      {
       "mod": {
        "dampen_taken": 5.26
       }
      }
     ]
    }
   ]
  },
  "None Shall Pass": {
   "rule": "The Gate, full set (3 pieces): after you block three hits, your next sword thrust is a sure crit, bypasses half of ward shields (bypass 0.5), and ignores 100 resistance points.",
   "approx": "Uses bypass 0.5 (the engine's bypass_cap) + pen 100 on the next sword-tagged hit.",
   "counters": [
