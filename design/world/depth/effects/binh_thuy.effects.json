    {
     "id": "slack_armed"
    },
    {
     "id": "slack_water_threshold"
    },
    {
     "id": "slack_just_healed"
    }
   ],
   "records": [
    {
     "id": "eff:Slack Water block",
     "on": "blocked",
     "if": [
      {
       "read": "event.amount",
       "op": ">",
       "value": 0
      }
     ],
     "do": [
      {
       "stacks": {
        "el": "water",
        "n": 1,
        "for": 8,
        "side": "own"
       }
      }
     ]
    },
    {
     "id": "eff:Slack Water arm",
