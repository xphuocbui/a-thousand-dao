         "read": "own.counter.slack_water_threshold",
         "op": ">=",
         "value": 1
        }
       ]
      },
      {
       "read": "own.buff.water",
       "op": ">=",
       "value": 4
      }
     ],
     "do": [
      {
       "counter": {
        "id": "slack_armed",
        "set": 1
       }
      }
     ]
    },
    {
     "id": "eff:Slack Water heal",
     "on": "art_fired",
     "filter": {
      "group": "still-moon-tide-scripture"
     },
     "if": [
      {
       "read": "own.counter.slack_armed",
       "op": ">=",
       "value": 1
      }
     ],
     "do": [
      {
       "counter": {
        "id": "slack_armed",
        "set": 0
       }
      },
      {
       "counter": {
        "id": "slack_just_healed",
        "set": 1
       }
      },
      {
