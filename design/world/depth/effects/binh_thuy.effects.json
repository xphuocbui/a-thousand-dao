        "el": "water",
        "n": 1,
        "for": 8,
        "side": "own"
       }
      }
     ]
    },
    {
     "id": "eff:Somewhere Else by Morning heal",
     "on": "pulse",
     "if": [
      {
       "read": "own.counter.crossing_tide",
       "op": ">=",
       "value": 1
      }
     ],
     "do": [
      {
       "heal": {
        "share": 0.05
       }
      },
      {
       "counter": {
        "id": "crossing_tide",
        "add": -1
       }
      }
     ]
    }
   ]
  },
  "The Tenth Layer": {
   "rule": "Slack Water, full set (3 pieces): the Shell's heal arms at 4 Water buff stacks instead of 5, each heal the Shell makes also grants 1 Water buff stack (8 s), and while you block, your Water buff stacks refresh their duration.",
