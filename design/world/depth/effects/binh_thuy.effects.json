{
 "_doc": "Bình Thủy Môn's Effect engine records (world-depth Stage 6; ADR-0009). Merged into assets/data/combat_effects.json under source world-depth:binh_thuy. Unpriced. Rule text from design/world/depth/sects/binh_thuy.items.json.",
 "source": "world-depth:binh_thuy",
 "effects": {
  "Every Day of the Year": {
   "rule": "Fan of the Following Wind: while you carry a Water buff stack, slows and timer delays do not slow you, and your first evade each fight grants 2 Water buff stacks (8 s).",
   "approx": "status_immune (slowed_time) and delay_immune apply against all foe slows and delays while carrying a Water buff stack, because the engine's status_immune and delay_immune checks do not expose the foe art's element.",
   "records": [
    {
     "id": "eff:Every Day of the Year slow",
     "on": "always",
     "if": [
      {
       "read": "own.buff.water",
       "op": ">=",
       "value": 1
      }
     ],
     "do": [
      {
       "mod": {
        "status_immune": 1,
        "status": "slowed_time"
       }
      }
     ]
    },
    {
     "id": "eff:Every Day of the Year delay",
     "on": "always",
     "if": [
      {
       "read": "own.buff.water",
       "op": ">=",
       "value": 1
      }
     ],
     "do": [
      {
       "mod": {
        "delay_immune": 1
       }
      }
     ]
    },
    {
     "id": "eff:Every Day of the Year evade",
     "on": "evaded",
     "limit": {
      "per_fight": 1
     },
     "do": [
      {
       "stacks": {
        "el": "water",
        "n": 2,
        "for": 8,
        "side": "own"
       }
      }
     ]
    }
   ]
  },
  "Slack Water": {
   "rule": "Shell of the Claw King: when you block a hit, gain 1 Water buff stack (8 s); at 5 Water buff stacks (4 with The Tenth Layer), your next Still Moon Tide art heals you for 4 % of your health.",
