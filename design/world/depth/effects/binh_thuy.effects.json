       }
      },
      {
       "counter": {
        "id": "slack_just_healed",
        "set": 0
       }
      }
     ]
    }
   ]
  },
  "Somewhere Else by Morning": {
   "rule": "The Crossing, full set (3 pieces): each time you evade, gain 1 Water buff stack (8 s); while you hold 5 or more Water buff stacks, your next evade spends 5 of them to raise a tide that heals you 5 % of your health (1 % per stack spent) each second for 5 s.",
   "counters": [
    {
     "id": "crossing_tide"
    }
   ],
   "records": [
    {
     "id": "eff:Somewhere Else by Morning tide",
     "on": "evaded",
     "if": [
      {
       "read": "own.buff.water",
       "op": ">=",
       "value": 5
      }
     ],
     "do": [
      {
       "consume": {
        "el": "water",
        "side": "own",
        "kind": "buff",
        "n": 5
