        "side": "foe"
       }
      },
      {
       "counter": {
        "id": "flood_was_up",
        "set": 0
       }
      }
     ]
    }
   ]
  },
  "Forced to Seed": {
   "rule": "The Yearly Seed, full set (3 pieces): each Fire art you cast resets the dry clock, refreshes every Wood buff stack on you, and adds 1 Wood buff stack for 10 s. If you go 10 s without casting a Fire art while carrying Wood buff stacks, all your Wood buff stacks flower at once: each heals 3 % of maximum health, they are consumed, and the 10 s clock restarts.",
   "counters": [
    {
     "id": "no_fire_sec"
    }
