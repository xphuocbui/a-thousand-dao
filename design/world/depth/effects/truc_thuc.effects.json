 "effects": {
  "Warm the Grove": {
   "rule": "Seed-Warming Censer (1v1 rewrite of allies -> you): Wood buff stacks you lay last 25 % longer (+2 to 2.5 s on 8-10 s batches), and when you gain Wood buff stacks (once per pulse) you also gain 1 Fire buff stack for 6 s and +0.5 % max health regeneration per second for 6 s.",
   "counters": [],
   "records": [
    {
     "id": "eff:Warm the Grove dur",
     "on": "always",
     "do": [
      {
       "mod": {
        "stack_dur": 25,
        "element": "wood",
        "kind": "buff"
       }
      }
     ]
    },
    {
     "id": "eff:Warm the Grove warmth",
     "on": "buff_gained",
     "filter": {
      "element": "wood"
     },
     "limit": {
      "per_pulse": 1
     },
     "do": [
      {
       "stacks": {
        "el": "fire",
        "n": 1,
        "for": 6,
        "side": "own",
        "kind": "buff"
       }
      },
      {
       "mod": {
        "hregen": 0.005,
        "for": 6
       }
      }
     ]
    }
   ]
  },
  "Measured Flood": {
   "rule": "Rain-Measure Gourd: Water field floods you lay (Open the Sluice or any Water field art) last 3 s longer (+3 flood_sec), and when the flood ends the foe keeps its slow (3 stacks of Slowed Time) for 1 more second.",
   "counters": [
    {
     "id": "flood_sec",
     "decay_per_pulse": 1
    },
    {
     "id": "flood_was_up"
    }
   ],
   "records": [
    {
     "id": "eff:Measured Flood extend",
     "on": "art_fired",
     "filter": {
      "element": "water",
      "tags": [
       "field"
      ]
     },
     "do": [
      {
       "counter": {
        "id": "flood_sec",
        "add": 3
       }
      },
      {
       "counter": {
        "id": "flood_was_up",
        "set": 1
       }
      }
     ]
    },
    {
     "id": "eff:Measured Flood linger",
