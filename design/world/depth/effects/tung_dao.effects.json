    },
    {
     "id": "eff:Answering Wave water",
     "on": "heal_restored",
     "limit": {
      "per_pulse": 1
     },
     "do": [
      {
       "stacks": {
        "el": "water",
        "n": 1,
        "for": 8,
        "side": "own"
       }
      }
     ]
    }
   ]
  },
