{
 "_doc": "Lạc Hà Tông's Effect engine records (world-depth Stage 6; ADR-0009). The input to tools/design/combat_sim/put_effects.py, which merges them into assets/data/combat_effects.json under source world-depth:lac_ha. Unpriced. Rule text from design/world/depth/sects/lac_ha.items.json and lac_ha.techniques.json. Geese in File (lh-cold-geese-sword) and Geese Line (long-sky-one-colour) are parked per design/world/depth/builds/postponed-2026-11-26.json and omitted.",
 "source": "world-depth:lac_ha",
 "effects": {
  "The Glow Deepens": {
   "rule": "Drifting Sunset Cloud True Canon (passive art, layer 3, authored wish d3): your glow clock is the fight's time plus 1.5 s per damaging blow taken this fight (approximating 1 s per 2 % max health lost to blows; healing never lowers it). For every 6 s on your glow clock, your Earth arts deal 4 % more damage, with no cap.",
   "approx": "blows advance glow_clock by 1.5 s per damaging hit (was_hit carries raw HP, not HP share)",
   "counters": [
    {
     "id": "glow_clock"
    }
   ],
   "records": [
    {
     "id": "glow-clock-pulse",
     "on": "pulse",
     "do": [
      {
       "counter": {
        "id": "glow_clock",
        "add": 1
       }
      }
     ]
    },
    {
     "id": "glow-clock-hit",
     "on": "was_hit",
     "if": [
      {
       "read": "event.amount",
       "op": ">",
       "value": 0
      }
     ],
     "do": [
      {
       "counter": {
        "id": "glow_clock",
        "add": 1.5
       }
      }
     ]
    },
    {
     "id": "eff:The Glow Deepens",
     "on": "always",
     "scale": {
      "read": "own.counter.glow_clock",
      "per": 6
     },
     "do": [
      {
       "mod": {
        "dmg_more": 0.04,
        "element": "earth"
       }
      }
     ]
    }
   ]
  },
  "The Lightning Sleeps": {
   "rule": "Tử Điện, Purple Lightning: without Thunder, the sword's lightning modifiers sleep and it strikes as a plain pierce sword. Every fourth Lightning art hit you land forks into a bonus Lightning hit (c 0.7) on the foe; if both Twin Swords are held together (Lightning and Frost), every fourth non-Lightning sword art hit wakes a half-strength fork (c 0.35 Lightning).",
   "approx": "one-on-one fight: the fork strikes the single foe instead of a second foe (ruling 2026-11-26); wakes on Lightning art hits (Thunder builds) or on non-Lightning sword art hits when the Twin Swords set sets twins_awake",
   "counters": [
    {
     "id": "td_fork"
    },
    {
     "id": "td_twins_fork"
    },
    {
     "id": "td_lit"
    },
