  "Frost on the Field": {
   "rule": "Thanh Sương, Blue Frost: without Ice, the sword's cold modifiers sleep. Against a slowed foe (Slowed Time), each Ice debuff grant you lay adds 1 extra Ice stack (doubling single-stack grants), and when woken by its scabbard (Waits for Its Blade), sword hits on a slowed foe lay 1 Ice stack (8 s, doubled to 2).",
   "counters": [
    {
     "id": "has_thanh_suong"
    },
    {
     "id": "frost_awake"
    }
   ],
   "records": [
    {
     "id": "eff:Frost on the Field mark",
     "on": "fight_start",
     "do": [
      {
       "counter": {
        "id": "has_thanh_suong",
        "set": 1
       }
      }
     ]
    },
    {
     "id": "eff:Frost on the Field double",
     "on": "always",
     "if": [
      {
       "read": "foe.status.slowed_time",
       "op": ">=",
       "value": 1
      }
     ],
     "do": [
      {
       "mod": {
        "stack_grant": 1,
        "element": "ice",
        "kind": "debuff"
       }
      }
     ]
    },
    {
     "id": "eff:Frost on the Field awake",
     "on": "hit_landed",
     "filter": {
      "tags": [
       "sword"
      ]
     },
     "if": [
      {
       "read": "own.counter.frost_awake",
       "op": ">=",
       "value": 1
      },
      {
