  "Every Debt Written": {
   "rule": "Vô Định Tally: each damaging blow you take adds 1 mark to your tally. Once per fight, when the tally reaches 8 marks or you fall to half health (with at least 1 mark), you call the tally: the foe takes a Physical Earth-ledger strike of c 0.35 per tallied mark (outside the trigger budget), and the tally resets.",
   "approx": "return_damage cannot read an accumulated damage counter, so a third of damage dealt is approximated as c 0.35 per tallied blow (outside_budget) auto-called at 8 marks or <= 50 % HP",
   "counters": [
    {
     "id": "debt_tally"
    },
    {
     "id": "debt_calls"
    },
    {
     "id": "debt_shield_due"
    },
    {
     "id": "debt_blk_hit",
     "decay_per_pulse": 1
    }
   ],
   "records": [
    {
     "id": "eff:Every Debt Written tally",
     "on": "was_hit",
     "if": [
      {
       "read": "event.amount",
       "op": ">",
       "value": 0
      },
      {
       "read": "own.counter.debt_blk_hit",
       "op": "==",
       "value": 0
      }
     ],
     "do": [
      {
       "counter": {
        "id": "debt_tally",
        "add": 1
       }
      }
     ]
    },
    {
     "id": "eff:Every Debt Written call",
     "on": "pulse",
     "if": [
      {
       "read": "own.counter.debt_calls",
       "op": "==",
       "value": 0
      },
      {
       "read": "own.counter.debt_tally",
       "op": ">=",
       "value": 1
      },
      {
       "any": [
        {
         "read": "own.counter.debt_tally",
         "op": ">=",
         "value": 8
        },
        {
         "read": "own.hp_share",
         "op": "<=",
         "value": 0.5
        }
       ]
      }
     ],
     "scale": {
      "read": "own.counter.debt_tally",
      "per": 1
     },
     "do": [
      {
       "free_hit": {
        "c": 0.35,
        "dtype": "phys",
        "outside_budget": true
       }
      },
      {
       "counter": {
        "id": "debt_shield_due",
        "add": 1
       }
      }
     ]
    },
    {
     "id": "eff:Every Debt Written reset",
     "on": "pulse",
     "if": [
      {
       "read": "own.counter.debt_calls",
       "op": "==",
       "value": 0
      },
      {
       "read": "own.counter.debt_shield_due",
       "op": ">=",
       "value": 1
