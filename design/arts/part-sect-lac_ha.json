 {"id": "the-sunset-clouds-fly-with-the-lone-duck", "name": "The Sunset Clouds Fly with the Lone Duck (Lạc Hà Cô Vụ Tề Phi)", "element": "earth", "role": "stacks", "tier": "authored", "power": "engine", "group": "sunset-cloud-canon", "tags": ["earth", "formation"], "c_art": 0.0, "cost_share": 0.05, "cooldown": 4, "kind": "elem", "guards": [{"read": "own.counter.sunset_cloud", "op": "<=", "value": 0}], "counters": [{"id": "sunset_cloud"}, {"id": "glow_clock"}], "states": [{"id": "sunset-cloud", "tags": ["field"], "mods": {}}], "effects": [{"id": "sunset-cloud-raise", "on": "art_fired", "filter": {"art_id": "the-sunset-clouds-fly-with-the-lone-duck"}, "do": [{"counter": {"id": "sunset_cloud", "set": 10}}]}, {"id": "sunset-cloud-field", "on": "art_fired", "filter": {"art_id": "the-sunset-clouds-fly-with-the-lone-duck"}, "if": [{"read": "own.state.any", "op": "==", "value": 0}], "do": [{"state": {"set": "sunset-cloud"}}]}, {"id": "sunset-cloud-tick", "on": "pulse", "if": [{"read": "own.counter.sunset_cloud", "op": ">=", "value": 1}], "do": [{"stacks": {"el": "earth", "n": 1, "for": 10, "side": "foe"}}, {"heal": {"share": 0.01}}]}, {"id": "sunset-cloud-slow", "on": "pulse", "if": [{"read": "own.counter.sunset_cloud", "op": ">=", "value": 1}, {"read": "foe.debuff.earth", "op": ">=", "value": 5}], "do": [{"status": {"id": "slowed_time", "stacks": 1, "dur": 2, "side": "foe"}}]}, {"id": "sunset-cloud-step", "on": "pulse", "if": [{"read": "own.counter.sunset_cloud", "op": ">=", "value": 1}], "do": [{"counter": {"id": "sunset_cloud", "add": -1}}]}, {"id": "sunset-cloud-end", "on": "pulse", "if": [{"read": "own.state.sunset-cloud", "op": ">=", "value": 1}, {"read": "own.counter.sunset_cloud", "op": "<=", "value": 0}], "do": [{"state": {"set": null}}]}, {"id": "glow-clock-pulse", "on": "pulse", "do": [{"counter": {"id": "glow_clock", "add": 1}}]}, {"id": "glow-clock-hit", "on": "was_hit", "if": [{"read": "event.amount", "op": ">", "value": 0}], "do": [{"counter": {"id": "glow_clock", "add": 1.5}}]}], "rule": "Raises a glowing cloud (a Field) for 10 s (enters the Sunset Cloud Field stance if you hold no other stance, so it never overwrites Mountain Stance). Each second while the cloud stands, the foe gains 1 Earth stack (10 s) and you heal 1 % of your health; at 5 or more Earth stacks on the foe, it also takes 1 Slowed Time (2 s). Also keeps your glow clock: +1 s each second of the fight plus +1.5 s per damaging blow taken (never wound back by healing).", "hooks": ["field", "earth stacks", "healing", "slowed time", "glow clock"], "sources": ["world-depth:lac_ha", "d3 red-sky-at-evening"]},
