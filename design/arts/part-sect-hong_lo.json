 {"id": "bank-the-coal", "name": "Bank the Coal (Ủ Than)", "element": "fire", "role": "stacks", "tier": "authored", "power": "engine", "group": "snow-hearth-primer", "tags": ["fire", "palm"], "c_art": 1.6, "cost_share": 0.03, "cooldown": 3.0, "kind": "elem", "debuff": [1, 6], "counters": [{"id": "coal", "each_for": 6}], "effects": [{"id": "bank-the-coal-hit", "on": "hit_landed", "filter": {"dtype": "fire"}, "do": [{"counter": {"id": "coal", "add": 1}}]}, {"id": "bank-the-coal-spend", "on": "art_fired", "filter": {"element": "water"}, "if": [{"read": "own.counter.coal", "op": ">=", "value": 1}], "do": [{"counter": {"id": "coal", "add": -1}}, {"stacks": {"el": "fire", "n": 2, "for": 6, "side": "foe"}}, {"gain_qi": {"share": 0.03}}]}], "rule": "A quick hearth palm that lays 1 Burn stack for 6 s. While slotted, each Fire hit you land banks a coal for 6 s; firing a Water art while you hold a coal spends one to lay 2 Burn stacks on the foe for 6 s and restore 3 % of your linh lực.", "hooks": ["fire stacks", "counters", "water", "linh lực return"], "sources": ["world-depth:hong_lo"]},
