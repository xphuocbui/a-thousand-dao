 "counters": [{"id": "charge"}],
 "effects": [
  {"id": "palm-gather", "on": "hit_landed", "filter": {"tags": ["lightning"], "kind": "art"}, "do": [{"counter": {"id": "charge", "add": 1}}]},
  {"id": "palm-discharge", "on": "art_fired", "filter": {"art_id": "capacitor-palm"}, "if": [{"read": "own.counter.charge", "op": ">=", "value": 1}],
   "scale": {"read": "own.counter.charge", "per": 1},
   "do": [{"free_hit": {"c": 0.22, "dtype": "lightning"}}, {"counter": {"id": "charge", "set": 0}}]}
 ],
 "rule": "Every Lightning art that lands stores 1 Charge, with no cap. Firing the Palm releases every Charge as a 0.22-coefficient lightning strike and empties the store.",
