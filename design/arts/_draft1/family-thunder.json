{"id": "overload-form", "name": "Overload Form (Quá Tải Thể)", "element": "thunder", "role": "utility", "tier": "authored",
 "tags": ["lightning", "form", "stance"], "c_art": 1.2, "cost_share": 0.03, "cooldown": 6, "kind": "elem",
 "states": [{"id": "overload", "mods": {"art_speed": 35, "crit": 20, "evade": -25}, "suppress": []}],
 "effects": [
  {"id": "overload-toggle", "on": "art_fired", "filter": {"art_id": "overload-form"}, "do": [{"state": {"set": "overload", "toggle": true}}]},
  {"id": "overload-feed", "on": "crit", "if": [{"read": "own.state.overload", "op": "==", "value": 1}], "limit": {"per_pulse": 3},
   "do": [{"stacks": {"el": "thunder", "n": 1, "for": 6, "side": "own"}}, {"self_hit": {"c": 0.1, "dtype": "lightning"}}]},
  {"id": "overload-burnout", "on": "pulse", "if": [{"read": "own.state.overload", "op": "==", "value": 1}, {"read": "own.qi_share", "op": "<=", "value": 0.15}],
   "do": [{"state": {"set": null}}]}
 ],
 "rule": "Firing it toggles Overload: +35 % art speed and +20 crit chance but -25 evade, and each crit gives you 1 Thunder buff stack and costs you a small lightning backlash. It ends when you toggle it again or your linh lực falls to 15 %.",
 "hooks": ["crit", "art speed", "thunder buff stacks", "lightning resistance", "low linh lực", "evade"],
 "sources": ["house-takes-all"]},

