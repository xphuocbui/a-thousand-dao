 "effects": [
  {"id": "cloud-raise", "on": "art_fired", "filter": {"art_id": "stormcloud-familiar"}, "do": [{"summon": {"c": 0.55, "dtype": "lightning", "cd": 2, "for": 9}}]},
  {"id": "cloud-mark", "on": "crit", "filter": {"kind": "companion"}, "limit": {"per_pulse": 2}, "do": [{"stacks": {"el": "thunder", "n": 1, "for": 6, "side": "foe"}}]}
 ],
 "rule": "Calls a small storm cloud that strikes for 0.55 coefficient every 2 s for 9 s. Each crit the cloud lands lays 1 Thunder debuff stack on the foe, up to 2 a pulse.",
