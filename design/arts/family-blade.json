  {"id": "afterimage-echo", "on": "crit", "limit": {"cooldown": 1.5}, "if": [{"read": "own.counter.afterimage", "op": ">=", "value": 3}],
   "do": [{"fire_art": {"which": "last", "share": 0.6}}, {"counter": {"id": "afterimage", "add": -3}}]}
 ],
 "steps": [
  {"unlock": [{"any": [{"read": "own.counter.afterimage", "op": ">=", "value": 4},
                       {"read": "own.state.flurry", "op": ">=", "value": 1},
                       {"read": "foe.status.bleed", "op": ">=", "value": 3}]}],
   "c_mult": 1.3},
  {"unlock": [{"read": "own.counter.afterimage", "op": ">=", "value": 7},
              {"any": [{"read": "own.fired_within.1.group.afterimage-sword-canon", "op": ">=", "value": 3},
                       {"read": "own.hp_share", "op": "<=", "value": 0.4},
                       {"read": "own.state.flurry", "op": ">=", "value": 1}]}],
   "pay": [{"counter": {"id": "afterimage", "add": -6}}], "c_mult": 2.8, "split": [0.34, 0.33, 0.33]}
 ],
 "rule": "Each of its hits and each crit of yours leaves an Afterimage; on a crit with 3 Afterimages, your last art fires again at 60 % and spends them. Fired with 4 Afterimages, Flurry Stance on, or 3 Bleed on the foe it hits 1.3 times as hard; the firing after that needs 7 Afterimages and either three canon arts in one pulse, you at 40 % health or less, or Flurry on; it spends 6 Afterimages and is three cuts of 2.8 times the force.",
 "hooks": ["crit", "crit multiplier", "art speed", "echo repeats", "last art damage", "afterimage count", "low health", "extra hits"], "sources": ["(gap)"]},

