{"id": "answering-peal", "name": "Answering Peal (Hồi Lôi)", "element": "thunder", "role": "damage", "tier": "authored",
 "tags": ["lightning", "peal", "echo"], "kind": "elem", "power": "engine", "group": "thousand-bolt-scripture",
