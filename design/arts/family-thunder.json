[
{"id": "capacitor-palm", "name": "Capacitor Palm (Tụ Lôi Chưởng)", "element": "thunder", "role": "damage", "tier": "authored",
 "tags": ["lightning", "palm", "heavy"], "kind": "elem", "power": "engine", "group": "thousand-bolt-scripture",
 "c_art": 1.0, "cost_share": 0.05, "cooldown": 5,
 "counters": [{"id": "charge"}],
 "effects": [
  {"id": "palm-gather", "on": "hit_landed", "filter": {"tags": ["lightning"], "kind": "art"}, "do": [{"counter": {"id": "charge", "add": 1}}]},
  {"id": "palm-gather-crit", "on": "crit", "limit": {"per_pulse": 2}, "do": [{"counter": {"id": "charge", "add": 1}}]},
  {"id": "palm-discharge", "on": "art_fired", "filter": {"art_id": "capacitor-palm"}, "if": [{"read": "own.counter.charge", "op": ">=", "value": 1}],
   "scale": {"read": "own.counter.charge", "per": 1},
   "do": [{"free_hit": {"c": 0.15, "dtype": "lightning"}}, {"counter": {"id": "charge", "set": 0}}]}
 ],
 "steps": [
  {"unlock": [{"any": [{"read": "own.counter.charge", "op": ">=", "value": 3}, {"read": "own.state.overload", "op": ">=", "value": 1}]}], "c_mult": 1.6},
  {"unlock": [{"read": "own.counter.charge", "op": ">=", "value": 6},
              {"any": [{"read": "foe.debuff.thunder", "op": ">=", "value": 6}, {"read": "own.fired_within.1.group.thousand-bolt-scripture", "op": ">=", "value": 3}]}],
   "pay": [{"consume": {"el": "thunder", "side": "own", "n": 3}}], "c_mult": 4}
 ],
 "rule": "Every Lightning art that lands, and every crit (twice a pulse at most), stores a Charge with no cap; firing the Palm releases each Charge as a 0.15 lightning strike and empties the store. With 3 Charges or Overload Form up it hits 1.6 times as hard, and the firing after that, with 6 Charges and either 6 Thunder stacks on the foe or three arts of its scripture fired in one pulse, burns 3 of your Thunder stacks to hit 4 times as hard.",
 "hooks": ["charges", "lightning art count", "crit", "thunder stacks", "free-hit / trigger damage", "art speed"],
 "sources": ["thunder-debt", "winnings"]},

