 "counters": [{"id": "peal", "each_for": 8}],
 "effects": [
  {"id": "peal-count", "on": "crit", "do": [{"counter": {"id": "peal", "add": 1}}]},
  {"id": "peal-slowed", "on": "status_applied", "limit": {"per_pulse": 1}, "if": [{"read": "foe.status.slowed_time", "op": ">=", "value": 1}], "do": [{"counter": {"id": "peal", "add": 1}}]},
  {"id": "peal-answer", "on": "crit", "if": [{"read": "own.counter.peal", "op": ">=", "value": 3}], "limit": {"per_pulse": 2},
   "do": [{"fire_art": {"which": "last", "share": 0.6}}, {"counter": {"id": "peal", "set": 0}}]}
 ],
 "empower": [
  {"if": [{"any": [{"read": "own.counter.peal", "op": ">=", "value": 3}, {"read": "own.fired_within.1.group.thousand-bolt-scripture", "op": ">=", "value": 3}]},
          {"any": [{"read": "foe.debuff.thunder", "op": ">=", "value": 3}, {"read": "own.buff.thunder", "op": ">=", "value": 2}]}],
   "c_mult": 3}
 ],
 "rule": "Each crit, and each time the foe is newly Slowed, adds a Peal that lasts 8 s; at 3 Peals the next crit fires your last art again at 60 % and clears them. The Peal itself hits 3 times as hard with 3 Peals or three arts of its scripture fired in one pulse, and also 3 Thunder stacks on the foe or 2 on you.",
 "hooks": ["crit", "last art", "art coefficient", "crit chance", "trigger damage", "echo count", "Slowed Time"],
 "sources": ["rolling-thunder", "rolling-peal"]},

{"id": "overload-form", "name": "Overload Form (Quá Tải Thể)", "element": "thunder", "role": "utility", "tier": "authored",
 "tags": ["lightning", "form", "stance"], "kind": "elem", "power": "standalone", "group": "thousand-bolt-scripture",
 "c_art": 0.0, "cost_share": 0.03, "cooldown": 6,
 "states": [{"id": "overload", "mods": {"art_speed": 25, "crit": 15, "evade": -25}, "suppress": []}],
 "effects": [
  {"id": "overload-toggle", "on": "art_fired", "filter": {"art_id": "overload-form"}, "do": [{"state": {"set": "overload", "toggle": true}}]},
  {"id": "overload-feed", "on": "crit", "if": [{"read": "own.state.overload", "op": "==", "value": 1}], "limit": {"per_pulse": 3},
   "do": [{"stacks": {"el": "thunder", "n": 1, "for": 6, "side": "own"}}, {"self_hit": {"c": 0.1, "dtype": "lightning"}}]},
  {"id": "overload-burnout", "on": "pulse", "if": [{"read": "own.state.overload", "op": "==", "value": 1}, {"read": "own.qi_share", "op": "<=", "value": 0.15}],
   "do": [{"state": {"set": null}}]}
 ],
 "rule": "Firing it toggles Overload: +25 % art speed and +15 crit chance but -25 evade, and each crit gives you 1 Thunder buff stack and a small lightning backlash. It ends when you toggle it again or your linh lực falls to 15 %.",
 "hooks": ["crit", "art speed", "thunder buff stacks", "lightning resistance", "low linh lực", "evade"],
 "sources": ["house-takes-all"]},

{"id": "tribulation-seal", "name": "Tribulation Seal (Kiếp Lôi Ấn)", "element": "thunder", "role": "stacks", "tier": "authored",
 "tags": ["lightning", "seal", "tribulation"], "kind": "elem", "power": "engine", "group": "heavenly-tribulation-scripture",
 "c_art": 0.4, "cost_share": 0.04, "cooldown": 6, "debuff": [4, 8],
 "effects": [
  {"id": "tribulation-rain", "on": "pulse", "if": [{"read": "foe.debuff.thunder", "op": ">=", "value": 8}],
   "scale": {"read": "foe.debuff.thunder", "per": 4},
   "do": [{"free_hit": {"c": 0.02, "dtype": "lightning"}}]}
 ],
 "steps": [
  {"unlock": [{"any": [{"read": "foe.debuff.thunder", "op": ">=", "value": 4}, {"read": "own.counter.charge", "op": ">=", "value": 4}, {"read": "foe.status.slowed_time", "op": ">=", "value": 1}]}], "c_mult": 2},
  {"unlock": [{"read": "foe.debuff.thunder", "op": ">=", "value": 6},
              {"any": [{"read": "foe.status.slowed_time", "op": ">=", "value": 2}, {"read": "foe.hp_share", "op": "<=", "value": 0.5},
                       {"read": "own.fired_within.1.group.heavenly-tribulation-scripture", "op": ">=", "value": 3}]}],
   "pay": [{"consume": {"el": "thunder", "side": "foe", "n": 6}}], "c_mult": 5}
 ],
 "rule": "Lays 4 Thunder debuff stacks for 8 s; every pulse the foe carries 8 or more, heaven strikes it for 0.02 per 4 stacks with no limit. With 4 stacks on the foe, 4 Charges or a Slowed foe the Seal hits twice as hard, and the firing after that, at 6 stacks and also a Slowed foe (2), a foe at 50 % health or three arts of its scripture in one pulse, calls down the verdict: it consumes 6 of the foe's stacks to hit 5 times as hard.",
 "hooks": ["thunder stacks", "stack duration", "crit", "pulse count", "trigger damage", "other stack sources", "low-health foe"],
 "sources": ["far-flash", "cloud-splitting-bolt", "thread-lightning-brand"]},

