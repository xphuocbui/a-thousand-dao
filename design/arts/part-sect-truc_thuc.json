 {"id": "shoot-after-rain", "name": "Shoot After Rain (Vũ Hậu Xuân Duẩn)", "element": "wood", "role": "damage", "tier": "authored", "power": "engine", "group": "rain-on-bamboo-breath", "tags": ["wood", "quick"], "c_art": 1.5, "cost_share": 0.03, "cooldown": 3.5, "kind": "elem", "buff": [1, 8], "counters": [{"id": "rain_fed", "decay_per_pulse": 1}], "effects": [{"id": "shoot-rain-water-art", "on": "art_fired", "filter": {"element": "water"}, "do": [{"counter": {"id": "rain_fed", "set": 5}}]}, {"id": "shoot-rain-water-hit", "on": "was_hit", "filter": {"dtype": "cold"}, "do": [{"counter": {"id": "rain_fed", "set": 5}}]}, {"id": "shoot-rain-water-heal", "on": "heal_restored", "filter": {"element": "water"}, "do": [{"counter": {"id": "rain_fed", "set": 5}}]}, {"id": "shoot-rain-speed", "on": "always", "if": [{"read": "own.counter.rain_fed", "op": ">=", "value": 1}], "do": [{"mod": {"art_speed": 25, "element": "wood"}}]}, {"id": "shoot-rain-extra", "on": "art_fired", "filter": {"element": "wood"}, "if": [{"read": "own.counter.rain_fed", "op": ">=", "value": 1}], "do": [{"stacks": {"el": "wood", "n": 1, "for": 8, "side": "own", "kind": "buff"}}, {"counter": {"id": "rain_fed", "set": 0}}]}], "rule": "A crisp Wood strike that grants 1 Wood buff stack for 8 s. For 5 s after you cast or are healed by a Water art, or are struck by Cold damage, your next Wood art comes out 25 % faster and lays 1 extra Wood buff stack for 8 s.", "hooks": ["wood buff stacks", "water arts", "art speed"], "sources": ["world-depth:truc_thuc"]},
 {"id": "bend-not-break", "name": "Bend, Not Break (Khuất Nhi Bất Chiết)", "element": "water", "role": "ward", "tier": "authored", "power": "engine", "group": "rain-on-bamboo-breath", "tags": ["water", "heal", "ward"], "c_art": 0.0, "cost_share": 0.03, "cooldown": 5.0, "kind": "elem", "c_heal": 0.5, "effects": [{"id": "bend-guard", "on": "art_fired", "filter": {"art_id": "bend-not-break"}, "do": [{"mod": {"dampen_taken": 33, "for": 2.5}}]}, {"id": "bend-heavy-hit", "on": "was_hit", "if": [{"read": "own.hp_share", "op": "<=", "value": 0.75}], "limit": {"cooldown": 4.0}, "do": [{"heal": {"of": "amount", "share": 0.25}}]}], "rule": "Bends with the rain like wet bamboo: a light Water heal that cuts incoming hits by a quarter (dampen_taken 33) for 2.5 s. When struck while at or below 75 % health (4 s cooldown), you yield and recover a quarter of the hit's damage as health.", "hooks": ["damage taken", "healing", "water arts", "low health"], "sources": ["world-depth:truc_thuc"]},
