[
 {
  "id": "pine-needle-rain",
  "name": "Needle Rain (Châm Vũ)",
  "element": "wood",
  "role": "stacks",
  "tier": "authored",
  "power": "standalone",
  "group": "listening-pine-primer",
  "tags": ["wood", "needle", "quick"],
  "c_art": 1.5,
  "cost_share": 0.03,
  "cooldown": 3,
  "kind": "elem",
  "debuff": [3, 5],
  "effects": [
   {
    "id": "pine-needle-rain-slow",
    "on": "hit_landed",
    "filter": {"art_id": "pine-needle-rain"},
    "limit": {"per_firing": 1},
    "if": [{"any": [{"read": "foe.buff.water", "op": ">=", "value": 1}, {"read": "foe.debuff.water", "op": ">=", "value": 1}]}],
    "do": [{"status": {"id": "slowed_time", "side": "foe", "stacks": 1, "for": 2.0}}]
   }
  ],
  "rule": "A spray of qi-hardened pine needles: deals Wood damage, lays 3 Wood debuff stacks for 5 s, and if the foe carries Water stacks lays 1 Slowed Time stack for 2 s.",
  "hooks": ["wood debuff stacks", "water stacks on foe", "slowed time"],
  "sources": ["world-depth:tung_dao"]
 },
 {
  "id": "ten-thousand-pines-answer",
