   },
   {
    "id": "pine-rain-close",
    "on": "pulse",
    "if": [{"read": "own.counter.pine_rain", "op": "==", "value": 0}, {"read": "own.state.pine-rain", "op": ">=", "value": 1}],
    "do": [{"state": {"set": null}}]
   }
  ],
  "rule": "Lays a 10 s rain field: restores 1 % health and 1 % linh lực each second, adds 1 Water debuff stack to the foe every 2 s, and doubles the duration of Wood stacks laid while the rain runs (sets Field state only if no stance is active).",
  "hooks": ["field", "healing", "linh lực restore", "water debuff stacks", "wood stack duration"],
  "sources": ["world-depth:tung_dao"]
 },
