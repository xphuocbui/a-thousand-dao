   },
   {
    "id": "pine-rain-pulse",
    "on": "pulse",
    "if": [{"read": "own.counter.pine_rain", "op": ">=", "value": 1}],
    "do": [{"heal": {"share": 0.01}}, {"gain_qi": {"share": 0.01}}, {"counter": {"id": "pine_rain", "add": -1}}, {"counter": {"id": "pine_rain_tick", "add": 1}}]
   },
   {
    "id": "pine-rain-foe-wet",
    "on": "pulse",
    "if": [{"read": "own.counter.pine_rain_tick", "op": ">=", "value": 2}],
