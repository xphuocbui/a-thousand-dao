  "element": "wood",
  "role": "utility",
  "tier": "authored",
  "power": "engine",
  "group": "pine-wave-true-canon",
  "tags": ["wood", "wave", "heal"],
  "c_art": 0.0,
  "c_heal": 0.5,
  "cost_share": 0.045,
  "cooldown": 10,
  "kind": "elem",
  "counters": [{"id": "pines_window", "cap": 8}, {"id": "pines_waves", "cap": 18}],
  "effects": [
   {
    "id": "pines-open",
    "on": "art_fired",
    "filter": {"art_id": "ten-thousand-pines-answer"},
    "do": [{"counter": {"id": "pines_window", "set": 8}}, {"counter": {"id": "pines_waves", "set": 9}}]
   },
   {
    "id": "pines-tick",
    "on": "pulse",
    "if": [{"read": "own.counter.pines_window", "op": ">=", "value": 1}],
    "do": [{"counter": {"id": "pines_window", "add": -1}}]
   },
   {
    "id": "pines-wave-stack",
    "on": "heal_restored",
    "limit": {"per_pulse": 1},
    "if": [{"read": "own.counter.pines_window", "op": ">=", "value": 1}],
    "do": [{"counter": {"id": "pines_waves", "add": 1}}, {"stacks": {"el": "wood", "n": 1, "for": 8, "side": "foe"}}]
   },
   {
    "id": "pines-wave-hit",
    "on": "heal_restored",
    "limit": {"per_pulse": 1},
    "if": [{"read": "own.counter.pines_window", "op": ">=", "value": 1}],
    "scale": {"read": "own.counter.pines_waves", "per": 1, "cap": 18},
    "do": [{"free_hit": {"c": 0.055, "dtype": "phys"}}, {"gain_qi": {"share": 0.0015}}]
   }
  ],
  "rule": "Mends a little and opens an 8 s window: each heal you receive (up to once a pulse) sends a wave that lays 1 Wood debuff stack on the foe, restores 1.5 % linh lực and strikes as a free Physical hit (c 0.55 on the first wave, +10 % per wave).",
  "hooks": ["healing", "heal_restored", "wood debuff stacks", "linh lực restore"],
  "sources": ["world-depth:tung_dao"]
 },
 {
  "id": "the-wave-comes-back",
  "name": "The Wave Comes Back (Đào Hồi)",
  "element": "water",
  "role": "heal",
  "tier": "authored",
  "power": "engine",
  "group": "pine-wave-true-canon",
  "tags": ["water", "wave", "heal"],
  "c_art": 0.0,
  "c_heal": 0.0,
  "cost_share": 0.05,
  "cooldown": 12,
  "kind": "elem",
  "counters": [{"id": "wave_mark", "cap": 10}, {"id": "wave_hits", "cap": 8}],
  "effects": [
   {
    "id": "wave-mark-set",
    "on": "art_fired",
    "filter": {"art_id": "the-wave-comes-back"},
    "do": [{"counter": {"id": "wave_mark", "set": 10}}, {"counter": {"id": "wave_hits", "set": 0}}]
   },
   {
    "id": "wave-mark-hit",
    "on": "was_hit",
    "limit": {"per_pulse": 1},
    "if": [{"read": "own.counter.wave_mark", "op": ">=", "value": 1}],
    "do": [{"counter": {"id": "wave_hits", "add": 1}}]
   },
   {
    "id": "wave-return-early",
    "on": "pulse",
    "if": [{"read": "own.counter.wave_mark", "op": ">=", "value": 1}, {"read": "own.hp_share", "op": "<", "value": 0.5}, {"read": "own.counter.wave_hits", "op": ">=", "value": 1}],
    "scale": {"read": "own.counter.wave_hits", "per": 1, "cap": 8},
    "do": [{"heal": {"share": 0.04}}, {"counter": {"id": "wave_mark", "set": 0}}, {"counter": {"id": "wave_hits", "set": 0}}]
   },
   {
    "id": "wave-return-end",
    "on": "pulse",
    "if": [{"read": "own.counter.wave_mark", "op": "==", "value": 1}, {"read": "own.counter.wave_hits", "op": ">=", "value": 1}],
    "scale": {"read": "own.counter.wave_hits", "per": 1, "cap": 8},
    "do": [{"heal": {"share": 0.04}}, {"counter": {"id": "wave_mark", "set": 0}}, {"counter": {"id": "wave_hits", "set": 0}}]
   },
   {
    "id": "wave-mark-expire",
    "on": "pulse",
    "if": [{"read": "own.counter.wave_mark", "op": "==", "value": 1}],
    "do": [{"counter": {"id": "wave_mark", "set": 0}}, {"counter": {"id": "wave_hits", "set": 0}}]
   },
   {
    "id": "wave-mark-tick",
    "on": "pulse",
    "if": [{"read": "own.counter.wave_mark", "op": ">=", "value": 2}],
    "do": [{"counter": {"id": "wave_mark", "add": -1}}]
   }
  ],
  "rule": "Marks your place for 10 s and counts each blow taken while marked (up to 8). When you drop below half health or the 10 s end, the wave pulls back and heals 4 % of your maximum health per blow taken (up to 32 %; non-spatial pullback and share-scaled heal).",
  "hooks": ["was_hit", "low health", "healing"],
  "sources": ["world-depth:tung_dao"]
 },
 {
  "id": "rain-through-the-needles",
