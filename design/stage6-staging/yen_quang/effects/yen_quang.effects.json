    },
    {
     "id": "furnace_burn"
    },
    {
     "id": "furnace_hp_cost",
     "upkeep": {
      "pool": "hp",
      "per_stack": 0.1
     }
    },
    {
     "id": "dusk_no_lit_cost"
    }
   ],
   "records": [
