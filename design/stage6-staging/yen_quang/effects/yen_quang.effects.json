 "effects": {
  "Lit at Dusk": {
   "rule": "Furnace of the Evening Glow (Mộ Quang Lô): after the fight's 20th second the furnace burns hotter: healing-over-time stacks (Wood buff stacks) the holder grants are 20 % stronger for the rest of the fight.",
   "counters": [],
   "records": [
    {
     "id": "eff:Lit at Dusk",
     "on": "always",
     "if": [
      {
       "read": "time",
       "op": ">=",
       "value": 20
      }
     ],
     "do": [
      {
       "mod": {
        "stack_more": 0.2,
        "element": "wood",
        "kind": "buff"
       }
      }
     ]
    }
   ]
  },
  "Unlit": {
   "rule": "The Cold Furnace (Lãnh Lô): until it is lit the furnace gives only its modifiers. It lights itself the first time the holder's health falls to 40 % or below: for 10 s his healing over time is doubled, and he loses 10 % of his maximum health (waived while Haze Held All Night is active via dusk_no_lit_cost).",
