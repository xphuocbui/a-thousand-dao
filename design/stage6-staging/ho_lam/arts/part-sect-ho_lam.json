  "id": "log-on-the-current",
  "name": "Log on the Current (Mộc Tùy Lưu)",
  "element": "wood",
  "role": "damage",
  "tier": "authored",
  "power": "engine",
  "group": "raft-and-root-primer",
  "tags": [
   "wood",
   "heavy"
  ],
  "c_art": 3.0,
  "cost_share": 0.05,
  "cooldown": 5.0,
  "kind": "elem",
  "empower": [
   {
    "if": [
     {
      "read": "own.buff.water",
      "op": ">=",
      "value": 1
     }
    ],
    "split": [
     1.0,
     0.5
    ]
   }
  ],
  "effects": [
   {
    "id": "log-current-delay",
    "on": "hit_landed",
    "filter": {
     "art_id": "log-on-the-current"
    },
    "limit": {
     "per_pulse": 1
    },
    "do": [
     {
      "timer": {
       "side": "foe",
       "which": "next",
       "by": 0.5
      }
     }
    ]
   }
  ],
  "rule": "A heavy Wood hit: the foe's soonest art waits 0.5 s; if a Water buff stack is on you, the hit carries on and strikes the foe again at half.",
  "hooks": [
   "wood damage",
   "timer delay",
   "water buff stacks",
   "split hits"
  ],
  "sources": [
   "world-depth:ho_lam",
   "a1"
  ]
