{
 "_doc": "Vọng Triều Đường's Effect engine records (world-depth Stage 6; ADR-0009). Merged into assets/data/combat_effects.json under source world-depth:vong_trieu by the serial step. Unpriced. Declares every counter it reads or writes in its own counters array for standalone GDScript compilation.",
 "source": "world-depth:vong_trieu",
 "effects": {
  "Lamp-Ward": {
   "rule": "Lamp-Ward (Thủ Đăng, lamp-ward-seal-canon L3 passive art): each Seal charge you gain turns 1 more blow before it ends, plus 1 more for every 3 Seal charges you already hold when you gain it.",
   "counters": [
    {"id": "has_lamp_ward", "cap": 1}
   ],
   "records": [
    {
     "id": "eff:Lamp-Ward init",
     "on": "fight_start",
     "do": [
      {"counter": {"id": "has_lamp_ward", "set": 1}}
     ]
    }
   ]
  },
  "The Lamp Flares": {
   "rule": "The Lamp Flares (Đăng Bùng, lamp-ward-seal-canon L4 passive art): when a blow spends the last of a ward seal, the seal flares with a crack of Force light striking the foe (0.3 + 0.1 per blow the seal turned; doubled under Bind the Flame Fuse) and inflicts 1 Slowed Time for 3 s.",
   "counters": [
    {"id": "seal_popped", "cap": 1},
    {"id": "seal_last_turned", "cap": 20},
    {"id": "seal_fuse", "cap": 1}
   ],
   "records": [
    {
     "id": "eff:The Lamp Flares base",
     "on": "was_hit",
     "filter": {"not_tags": ["trigger"]},
     "if": [
      {"read": "own.counter.seal_popped", "op": ">=", "value": 1},
      {"read": "own.counter.seal_fuse", "op": "==", "value": 0}
     ],
     "do": [
      {"free_hit": {"c": 0.3, "dtype": "force", "outside_budget": true}},
      {"status": {"id": "slowed_time", "stacks": 1, "dur": 3, "side": "foe"}}
     ]
    },
    {
     "id": "eff:The Lamp Flares scale",
     "on": "was_hit",
     "filter": {"not_tags": ["trigger"]},
     "if": [
      {"read": "own.counter.seal_popped", "op": ">=", "value": 1},
      {"read": "own.counter.seal_last_turned", "op": ">=", "value": 1},
      {"read": "own.counter.seal_fuse", "op": "==", "value": 0}
     ],
     "scale": {"read": "own.counter.seal_last_turned", "per": 1},
     "do": [
      {"free_hit": {"c": 0.1, "dtype": "force", "outside_budget": true}}
     ]
    },
    {
     "id": "eff:The Lamp Flares fuse base",
     "on": "was_hit",
     "filter": {"not_tags": ["trigger"]},
     "if": [
      {"read": "own.counter.seal_popped", "op": ">=", "value": 1},
      {"read": "own.counter.seal_fuse", "op": ">=", "value": 1}
     ],
     "do": [
      {"free_hit": {"c": 0.6, "dtype": "force", "outside_budget": true}},
      {"status": {"id": "slowed_time", "stacks": 1, "dur": 3, "side": "foe"}}
     ]
    },
    {
     "id": "eff:The Lamp Flares fuse scale",
     "on": "was_hit",
     "filter": {"not_tags": ["trigger"]},
     "if": [
      {"read": "own.counter.seal_popped", "op": ">=", "value": 1},
      {"read": "own.counter.seal_last_turned", "op": ">=", "value": 1},
      {"read": "own.counter.seal_fuse", "op": ">=", "value": 1}
     ],
     "scale": {"read": "own.counter.seal_last_turned", "per": 1},
     "do": [
      {"free_hit": {"c": 0.2, "dtype": "force", "outside_budget": true}}
     ]
    },
    {
     "id": "eff:The Lamp Flares clear",
     "on": "was_hit",
     "filter": {"not_tags": ["trigger"]},
     "if": [{"read": "own.counter.seal_popped", "op": ">=", "value": 1}],
     "do": [
      {"counter": {"id": "seal_popped", "set": 0}},
      {"counter": {"id": "seal_last_turned", "set": 0}}
     ]
    }
   ]
  },
  "The Lamp That Is Not Out": {
   "rule": "The Unsleeping Lamp (vtd-unsleeping-lamp): while the lamp is lit, her ward seals last 4 s longer, and the first seal of hers to burn out each fight relights once.",
   "counters": [
    {"id": "seal", "cap": 9},
    {"id": "seal_blows", "cap": 20},
    {"id": "seal_ttl", "cap": 14},
    {"id": "seal_just_emptied", "cap": 1},
    {"id": "has_unsleeping_lamp", "cap": 1},
    {"id": "unsleeping_used", "cap": 1},
    {"id": "lamp_just_relit", "cap": 1},
    {"id": "has_lamp_ward", "cap": 1},
    {"id": "seal_fuse", "cap": 1}
   ],
   "records": [
    {
     "id": "eff:The Lamp That Is Not Out init",
     "on": "fight_start",
     "do": [
      {"counter": {"id": "has_unsleeping_lamp", "set": 1}}
     ]
    },
    {
     "id": "eff:The Lamp That Is Not Out relight",
     "on": "was_hit",
     "filter": {"not_tags": ["trigger"]},
     "limit": {"per_fight": 1},
     "if": [
      {"read": "own.counter.seal_just_emptied", "op": ">=", "value": 1},
      {"read": "own.counter.seal", "op": "==", "value": 0},
      {"read": "own.counter.unsleeping_used", "op": "==", "value": 0}
     ],
     "do": [
      {"counter": {"id": "lamp_just_relit", "set": 1}},
      {"counter": {"id": "seal", "set": 1}},
      {"counter": {"id": "seal_blows", "set": 3}},
      {"counter": {"id": "seal_ttl", "set": 14}},
      {"counter": {"id": "seal_just_emptied", "set": 0}},
      {"counter": {"id": "unsleeping_used", "set": 1}}
     ]
    },
    {
     "id": "eff:The Lamp That Is Not Out relight ward",
     "on": "was_hit",
     "filter": {"not_tags": ["trigger"]},
     "if": [
      {"read": "own.counter.lamp_just_relit", "op": ">=", "value": 1},
      {"read": "own.counter.has_lamp_ward", "op": ">=", "value": 1}
     ],
     "do": [
      {"counter": {"id": "seal_blows", "add": 1}}
     ]
    },
    {
     "id": "eff:The Lamp That Is Not Out relight fuse",
     "on": "was_hit",
     "filter": {"not_tags": ["trigger"]},
     "if": [
      {"read": "own.counter.lamp_just_relit", "op": ">=", "value": 1},
      {"read": "own.counter.seal_fuse", "op": ">=", "value": 1},
      {"read": "own.counter.seal_blows", "op": ">=", "value": 2}
     ],
     "do": [
      {"counter": {"id": "seal_blows", "add": -1}}
     ]
    },
    {
     "id": "eff:The Lamp That Is Not Out relight done",
     "on": "was_hit",
     "filter": {"not_tags": ["trigger"]},
     "if": [{"read": "own.counter.lamp_just_relit", "op": ">=", "value": 1}],
     "do": [
      {"counter": {"id": "lamp_just_relit", "set": 0}}
     ]
    }
   ]
  },
  "Not One Lamp Out": {
   "rule": "The Lamp Chain, full set (3 pieces: vtd-unsleeping-lamp, vtd-kim-sa-seal, vtd-pearl-diver-robe): while you cast no escape art, your ward seals do not burn out, and each seal that turns a blow passes one more turn to the next seal in the line (+1 % ward strength per passed turn). If you cast an escape art, every seal burns out after 3 s.",
   "counters": [
    {"id": "not_one_lamp", "cap": 1},
    {"id": "lamp_escaped", "cap": 1},
    {"id": "lamp_escape_ttl", "cap": 5},
    {"id": "seal", "cap": 9},
    {"id": "seal_blows", "cap": 20},
    {"id": "seal_ttl", "cap": 14},
    {"id": "seal_pass_turns", "cap": 20}
   ],
   "records": [
    {
     "id": "eff:Not One Lamp Out init",
     "on": "fight_start",
     "do": [
      {"counter": {"id": "not_one_lamp", "set": 1}}
     ]
    },
    {
     "id": "eff:Not One Lamp Out pass",
     "on": "was_hit",
     "filter": {"not_tags": ["trigger"]},
     "if": [
      {"read": "own.counter.seal", "op": ">=", "value": 1},
      {"read": "own.counter.lamp_escaped", "op": "==", "value": 0}
     ],
     "do": [
      {"counter": {"id": "seal_pass_turns", "add": 1}}
     ]
    },
    {
     "id": "eff:Not One Lamp Out ward",
     "on": "always",
     "if": [
      {"read": "own.counter.seal", "op": ">=", "value": 1},
      {"read": "own.counter.seal_pass_turns", "op": ">=", "value": 1}
     ],
     "scale": {"read": "own.counter.seal_pass_turns", "per": 1},
     "do": [
      {"mod": {"ward_pct": 1}}
     ]
    },
    {
     "id": "eff:Not One Lamp Out escape",
     "on": "art_fired",
     "filter": {"tags": ["escape"]},
     "do": [
      {"counter": {"id": "lamp_escaped", "set": 1}},
      {"counter": {"id": "lamp_escape_ttl", "set": 4}}
     ]
    },
    {
     "id": "eff:Not One Lamp Out tick",
     "on": "pulse",
     "if": [{"read": "own.counter.lamp_escape_ttl", "op": ">=", "value": 2}],
     "do": [
      {"counter": {"id": "lamp_escape_ttl", "add": -1}}
     ]
    },
    {
     "id": "eff:Not One Lamp Out expire",
     "on": "pulse",
     "if": [{"read": "own.counter.lamp_escape_ttl", "op": "==", "value": 1}],
     "do": [
      {"counter": {"id": "lamp_escape_ttl", "set": 0}},
      {"counter": {"id": "seal", "set": 0}},
      {"counter": {"id": "seal_blows", "set": 0}},
      {"counter": {"id": "seal_ttl", "set": 0}},
      {"counter": {"id": "seal_pass_turns", "set": 0}}
     ]
    }
   ]
  },
  "Layered Against the Tide": {
   "rule": "The Breakwater, full set (3 pieces: vtd-breakwater-seal, vtd-sea-wall-shield, vtd-jetty-stone): each blow your shield or wards turn adds a layer that fades after 5 s, and each layer cuts the damage you take by a further 4 %. At five or more layers your next seal spends them all and lays 2 Heavy Breath on the foe, and one more for every five layers past five.",
   "counters": [
    {"id": "tide_layer", "cap": 15, "each_for": 5},
    {"id": "seal", "cap": 9}
   ],
   "records": [
    {
     "id": "eff:Layered Against the Tide gain",
     "on": "was_hit",
     "filter": {"not_tags": ["trigger"]},
     "if": [
      {"any": [
       {"read": "own.counter.seal", "op": ">=", "value": 1},
       {"read": "own.qi_share", "op": ">", "value": 0},
       {"read": "own.body_shield_share", "op": ">", "value": 0}
      ]}
     ],
     "do": [
      {"counter": {"id": "tide_layer", "add": 1}}
     ]
    },
    {
     "id": "eff:Layered Against the Tide dampen",
     "on": "always",
     "if": [{"read": "own.counter.tide_layer", "op": ">=", "value": 1}],
     "scale": {"read": "own.counter.tide_layer", "per": 1},
     "do": [
      {"mod": {"dampen_taken": 4}}
     ]
    },
    {
     "id": "eff:Layered Against the Tide extra",
     "on": "art_fired",
     "filter": {"tags": ["seal"]},
     "if": [{"read": "own.counter.tide_layer", "op": ">=", "value": 10}],
     "do": [
      {"status": {"id": "heavy_breath", "stacks": 1, "dur": 4, "side": "foe"}}
     ]
    },
    {
     "id": "eff:Layered Against the Tide spend",
     "on": "art_fired",
     "filter": {"tags": ["seal"]},
     "if": [{"read": "own.counter.tide_layer", "op": ">=", "value": 5}],
     "do": [
      {"status": {"id": "heavy_breath", "stacks": 2, "dur": 4, "side": "foe"}},
      {"counter": {"id": "tide_layer", "set": 0}}
     ]
    }
   ]
  }
 }
}
