     "on": "was_hit",
     "filter": {
      "element": "wind",
      "kind": "art"
     },
     "limit": {
      "per_pulse": 1
     },
     "if": [
      {
       "read": "own.counter.mist_field",
       "op": "==",
       "value": 0
      },
      {
       "read": "own.counter.road_mist",
       "op": ">=",
       "value": 1
      }
     ],
     "do": [
      {
       "counter": {
        "id": "road_mist",
        "set": 0
       }
      }
     ]
    },
