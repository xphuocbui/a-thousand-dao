  "The Mist Does Not Ask": {
   "rule": "Mist-Lock Lantern: while you stand inside your own mist field, your mist does not fade; if you leave it, it fades twice as fast.",
   "approx": "Standing inside vs leaving in non-spatial fight.py is read via own.composed >= 1 vs == 0: sets mist_lantern = 1 at fight start so Lock the Road skips normal pulse decay while Composed, and deducts an extra 1 s on pulse while own.composed == 0.",
   "counters": [
    {
     "id": "mist_field",
     "cap": 20
    },
    {
     "id": "mist_lantern",
     "cap": 1
    }
   ],
   "records": [
    {
     "id": "eff:The Mist Does Not Ask:hold-flag",
     "on": "fight_start",
     "limit": {
      "per_fight": 1
     },
     "do": [
      {
       "counter": {
        "id": "mist_lantern",
        "set": 1
       }
      }
     ]
    },
    {
     "id": "eff:The Mist Does Not Ask:double-fade",
     "on": "pulse",
     "if": [
      {
       "read": "own.counter.mist_field",
       "op": ">=",
       "value": 1
