 {"id": "pill-smoke", "name": "Pill Smoke (Đan Yên)", "element": "", "role": "stacks", "tier": "authored", "power": "standalone", "group": "censer-smoke-manual", "tags": ["smoke", "pill", "censer", "over_time"], "c_art": 0.6, "cost_share": 0.04, "cooldown": 6.0, "kind": "elem", "convert": {"to": "chaos", "share": 1.0}, "effects": [{"id": "smoke-burn-pill", "on": "art_fired", "filter": {"art_id": "pill-smoke"}, "do": [{"burn_pill": {"stacks_per_grade": 4, "for": 6.0}}]}], "rule": "A puff of censer smoke: a small Chaos hit. If a pill is prepared in your pill slot, the censer burns it once a fight to lay a cloud of 4 debuff stacks per pill grade for 6 s of the pill's element (Water smokes as Ice, no element as Wood).", "hooks": ["pills", "element debuffs", "over time", "censer"], "notes": "Self half-strength pill effect awaits full pill-effect combat support (engine.py Pill Smoke slice 3); burn_pill directly lays the foe stack cloud without a separate smoke-cloud Effect.", "sources": ["rb-18", "e2"]},
 {"id": "balance-the-books", "name": "Balance the Books (Bình Trướng)", "element": "metal", "role": "damage", "tier": "authored", "power": "engine", "group": "golden-valley-ledger-canon", "tags": ["metal", "coin"], "c_art": 1.5, "cost_share": 0.04, "cooldown": 5.0, "kind": "phys", "counters": [{"id": "ledger_credit"}], "effects": [{"id": "ledger-count-give", "on": "hit_landed", "do": [{"counter": {"id": "ledger_credit", "add": 1}}]}, {"id": "ledger-count-take", "on": "was_hit", "if": [{"read": "event.amount", "op": ">", "value": 0}], "do": [{"counter": {"id": "ledger_credit", "add": -1}}]}, {"id": "ledger-spend", "on": "art_fired", "filter": {"art_id": "balance-the-books"}, "if": [{"read": "own.counter.ledger_credit", "op": ">=", "value": 1}], "scale": {"read": "own.counter.ledger_credit", "per": 1}, "do": [{"mod": {"L5": 12, "element": "metal", "kind": "art", "for": 5.0}}, {"counter": {"id": "ledger_credit", "set": 0}}]}], "rule": "A crisp coin strike that settles your running exchange ledger: each hit you land enters +1 credit and each damaging hit you take enters -1; casting Balance the Books spends positive net credit to empower your Metal arts for 5 s (+12 L5 per net hit).", "hooks": ["counters", "metal", "coin"], "sources": ["world-depth:market-folk"]},
 {"id": "call-the-debt", "name": "Call the Debt (Thu Trái)", "element": "earth", "role": "curse", "tier": "authored", "power": "engine", "group": "golden-valley-ledger-canon", "tags": ["earth", "debt", "over_time"], "c_art": 1.2, "cost_share": 0.04, "cooldown": 7.0, "kind": "elem", "debuff": [2, 8], "counters": [{"id": "debt_active"}, {"id": "debt_sum"}], "effects": [{"id": "call-debt-open", "on": "hit_landed", "filter": {"art_id": "call-the-debt"}, "do": [{"counter": {"id": "debt_active", "set": 8}}, {"counter": {"id": "debt_sum", "add": 2}}]}, {"id": "call-debt-grow", "on": "pulse", "if": [{"read": "own.counter.debt_active", "op": ">=", "value": 1}, {"read": "foe.debuff.earth", "op": ">=", "value": 1}], "do": [{"stacks": {"el": "earth", "n": 1, "for": 8.0, "side": "foe"}}, {"counter": {"id": "debt_sum", "add": 1}}, {"counter": {"id": "debt_active", "add": -1}}]}, {"id": "call-debt-clear", "on": "pulse", "if": [{"read": "own.counter.debt_sum", "op": ">=", "value": 1}, {"read": "foe.debuff.earth", "op": "==", "value": 0}], "do": [{"counter": {"id": "debt_active", "set": 0}}, {"counter": {"id": "debt_sum", "set": 0}}]}, {"id": "call-debt-burst", "on": "cleansed", "if": [{"read": "own.counter.debt_sum", "op": ">=", "value": 1}], "scale": {"read": "own.counter.debt_sum", "per": 1}, "do": [{"free_hit": {"c": 0.45, "dtype": "chaos", "pass_shields": true}}, {"counter": {"id": "debt_sum", "set": 0}}, {"counter": {"id": "debt_active", "set": 0}}]}], "rule": "Lays 2 Earth debuff stacks (8 s) and accrues 1 additional Earth stack each pulse while active; if the foe cleanses your debuffs while debt stands, the whole accrued debt bursts for 0.45 c Chaos damage per stack.", "hooks": ["earth stacks", "cleansed", "over time"], "sources": ["world-depth:market-folk"]},
 {"id": "draw-the-poison", "name": "Draw the Poison (Bạt Độc)", "element": "wood", "role": "heal", "tier": "authored", "power": "engine", "group": "second-spring-needle-art", "tags": ["wood", "heal", "cleanse", "needle"], "c_art": 0.0, "c_heal": 1.6, "cleanse": 2, "cost_share": 0.04, "cooldown": 5.0, "kind": "elem", "effects": [{"id": "draw-poison-curse", "on": "art_fired", "filter": {"art_id": "draw-the-poison"}, "if": [{"read": "own.curses", "op": ">=", "value": 1}], "do": [{"cleanse": {"curses": 1}}]}], "rule": "Needles draw poison and stagnant qi back along the meridian: restores health (1.6 c), cleanses 2 debuff stacks, and clears 1 curse if you carry one.", "hooks": ["heal", "cleanse", "curses", "needle"], "sources": ["world-depth:market-folk", "a1"]},
 {"id": "apricot-second-spring", "name": "Second Spring (Hồi Xuân)", "element": "wood", "role": "heal", "tier": "authored", "power": "engine", "group": "second-spring-needle-art", "tags": ["wood", "heal", "needle"], "c_art": 0.0, "c_heal": 2.0, "buff": [2, 6], "cost_share": 0.05, "cooldown": 7.0, "kind": "elem", "counters": [{"id": "spring_hot"}], "effects": [{"id": "apricot-spring-open", "on": "art_fired", "filter": {"art_id": "apricot-second-spring"}, "do": [{"counter": {"id": "spring_hot", "set": 5}}]}, {"id": "apricot-spring-base", "on": "pulse", "if": [{"read": "own.counter.spring_hot", "op": ">=", "value": 1}], "do": [{"heal": {"share": 0.01}}]}, {"id": "apricot-spring-deep", "on": "pulse", "if": [{"read": "own.counter.spring_hot", "op": ">=", "value": 1}, {"read": "own.hp_missing_share", "op": ">", "value": 0}], "scale": {"read": "own.hp_missing_share", "per": 0.25, "floor": false}, "do": [{"heal": {"share": 0.008}}]}, {"id": "apricot-spring-tick", "on": "pulse", "if": [{"read": "own.counter.spring_hot", "op": ">=", "value": 1}], "do": [{"counter": {"id": "spring_hot", "add": -1}}]}], "rule": "A slow apricot-clinic needle cure: restores health (2.0 c) and 2 Wood buff stacks (6 s), then pulses slow healing over 5 s that grows stronger as your health falls.", "hooks": ["heal", "wood stacks", "missing health", "needle"], "sources": ["world-depth:market-folk"]},
 {"id": "relay-the-grid", "name": "Relay the Grid (Trùng Bố)", "element": "earth", "role": "control", "tier": "authored", "power": "engine", "group": "loom-of-letters-array", "tags": ["earth", "formation", "seal"], "c_art": 1.5, "cost_share": 0.04, "cooldown": 5.0, "kind": "elem", "debuff": [2, 8], "counters": [{"id": "grid_laid", "cap": 1}], "effects": [{"id": "relay-grid-speed", "on": "always", "if": [{"read": "own.counter.grid_laid", "op": ">=", "value": 1}], "do": [{"mod": {"art_speed": 60, "tags": ["formation"]}}]}, {"id": "relay-grid-mark", "on": "art_fired", "filter": {"art_id": "relay-the-grid"}, "if": [{"read": "own.counter.grid_laid", "op": "==", "value": 0}], "do": [{"counter": {"id": "grid_laid", "set": 1}}]}, {"id": "relay-grid-haste", "on": "art_fired", "filter": {"art_id": "relay-the-grid"}, "if": [{"read": "own.counter.grid_laid", "op": ">=", "value": 1}], "do": [{"timer": {"side": "own", "which": "longest", "by": -1.5}}]}], "rule": "Re-inks the star-script grid: deals Earth damage (1.5 c, 2 Earth stacks for 8 s); after the first cast in a fight, your formation arts cast faster (+60 % art speed) and each relay cuts 1.5 s off your longest-cooling art.", "hooks": ["formation", "art speed", "timer hasten"], "sources": ["world-depth:market-folk"]},
 {"id": "walking-ward", "name": "Walking Ward (Hành Trận)", "element": "earth", "role": "ward", "tier": "authored", "power": "engine", "group": "loom-of-letters-array", "tags": ["earth", "formation", "ward"], "c_art": 0.0, "cost_share": 0.04, "cooldown": 9.0, "kind": "elem", "counters": [{"id": "stars_bow"}, {"id": "ring", "each_for": 14}, {"id": "walking_field"}, {"id": "walking_refreshed", "cap": 1}], "states": [{"id": "walking-ward-field", "tags": ["field", "composed"], "mods": {"dampen_taken": 12}}, {"id": "stars-bow", "tags": ["field"], "mods": {}}, {"id": "armillary-ring", "tags": ["field"], "mods": {}}], "effects": [{"id": "walking-ward-grow", "on": "art_fired", "filter": {"art_id": "walking-ward"}, "do": [{"ward_grow": {"share": 0.14, "of": "hp"}}]}, {"id": "walking-ward-field", "on": "art_fired", "filter": {"art_id": "walking-ward"}, "if": [{"read": "own.field_up", "op": "<", "value": 1}], "do": [{"state": {"set": "walking-ward-field"}}, {"counter": {"id": "walking_field", "set": 10}}]}, {"id": "walking-ward-refresh-bow", "on": "art_fired", "filter": {"art_id": "walking-ward"}, "if": [{"read": "own.counter.walking_refreshed", "op": "==", "value": 0}, {"read": "own.counter.stars_bow", "op": ">=", "value": 1}], "do": [{"counter": {"id": "stars_bow", "set": 8}}, {"counter": {"id": "walking_refreshed", "set": 1}}]}, {"id": "walking-ward-refresh-ring", "on": "art_fired", "filter": {"art_id": "walking-ward"}, "if": [{"read": "own.counter.walking_refreshed", "op": "==", "value": 0}, {"read": "own.counter.ring", "op": ">=", "value": 1}], "do": [{"counter": {"id": "ring", "add": 1}}, {"counter": {"id": "walking_refreshed", "set": 1}}]}, {"id": "walking-ward-tick", "on": "pulse", "if": [{"read": "own.counter.walking_field", "op": ">=", "value": 1}], "do": [{"counter": {"id": "walking_field", "add": -1}}]}, {"id": "walking-ward-handoff-bow", "on": "pulse", "if": [{"read": "own.state.walking-ward-field", "op": ">=", "value": 1}, {"read": "own.counter.walking_field", "op": "==", "value": 0}, {"read": "own.counter.stars_bow", "op": ">=", "value": 1}], "do": [{"state": {"set": "stars-bow"}}]}, {"id": "walking-ward-handoff-ring", "on": "pulse", "if": [{"read": "own.state.walking-ward-field", "op": ">=", "value": 1}, {"read": "own.counter.walking_field", "op": "==", "value": 0}, {"read": "own.counter.stars_bow", "op": "==", "value": 0}, {"read": "own.counter.ring", "op": ">=", "value": 1}], "do": [{"state": {"set": "armillary-ring"}}]}, {"id": "walking-ward-end", "on": "pulse", "if": [{"read": "own.state.walking-ward-field", "op": ">=", "value": 1}, {"read": "own.counter.walking_field", "op": "==", "value": 0}, {"read": "own.counter.stars_bow", "op": "==", "value": 0}, {"read": "own.counter.ring", "op": "==", "value": 0}], "do": [{"state": {"set": null}}]}], "rule": "Raises a walking formation ward (+14 % max-HP stance ward, sets a Composed Field with -12 % damage taken for 10 s if no Field stands) and, once a fight, refreshes your active array Field duration.", "hooks": ["field", "stance ward", "formation"], "sources": ["world-depth:market-folk", "a1"]},
 {"id": "vault-coin-toss", "name": "Vault Coin Toss (Trệ Kim Tiền)", "element": "metal", "role": "damage", "tier": "authored", "power": "engine", "group": "buried-vault-coin-canon", "tags": ["metal", "coin", "cache"], "c_art": 1.5, "cost_share": 0.03, "cooldown": 3.0, "kind": "phys", "counters": [{"id": "vault_cache"}, {"id": "vault_skip", "cap": 1}], "effects": [{"id": "vault-coin-burst", "on": "art_fired", "filter": {"art_id": "vault-coin-toss"}, "if": [{"read": "own.counter.vault_cache", "op": ">=", "value": 2}], "do": [{"free_hit": {"c": 0.9, "dtype": "phys"}}, {"counter": {"id": "vault_cache", "set": 0}}, {"counter": {"id": "vault_skip", "set": 1}}]}, {"id": "vault-coin-cache", "on": "art_fired", "filter": {"art_id": "vault-coin-toss"}, "if": [{"read": "own.counter.vault_skip", "op": "==", "value": 0}], "do": [{"counter": {"id": "vault_cache", "add": 1}}]}, {"id": "vault-coin-unskip", "on": "art_fired", "filter": {"art_id": "vault-coin-toss"}, "if": [{"read": "own.counter.vault_skip", "op": ">=", "value": 1}], "do": [{"counter": {"id": "vault_skip", "set": 0}}]}], "rule": "Flips a heavy vault coin (1.5 c Physical) and sets aside 1 cache charge; every third toss empties the cache for a second 0.9 c strike.", "hooks": ["coin", "counters", "physical"], "sources": ["world-depth:market-folk"]},
