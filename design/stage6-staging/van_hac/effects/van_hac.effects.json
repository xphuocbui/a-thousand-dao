  "Silence After the Twelfth": {
   "rule": "The Monk's Things, full set (3 pieces): each echo the Zither sounds adds one Resonance to its foe; when you stop playing (The Held Rest), a foe with 6 or more Resonance falls into the silence: its clock stops for 1 s and its casting is 30 % slower for 3 s.",
   "approx": "Uses stop_clock (foe, 1.0 s) + 3 stacks of Slowed Time for 3 s instead of single-tag Silence so all foe arts stall and slow.",
   "counters": [
    {
     "id": "held_rest"
    }
   ],
   "records": [
