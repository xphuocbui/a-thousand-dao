  "Pines in Ten Thousand Ravines": {
   "rule": "Pine-Wind Zither (vh-tung-phong-cam): Each song art you play echoes once on the next pulse as a 0.8 c Force strike (about half a note's strength) and adds 1 Resonance stack to the foe. Echoes cannot themselves echo.",
   "counters": [
    {
     "id": "cam_echo"
    }
   ],
   "records": [
    {
     "id": "eff:Pines in Ten Thousand Ravines queue",
     "on": "art_fired",
