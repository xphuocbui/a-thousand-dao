  "The Censer Remembers": {
   "rule": "The Ash Seat, full set (3 pieces): each second a foe burns under your Fire, the censer banks 0.5 % of your health, and the bank leaks 2 % of itself each second you deal no Fire. When you rise from the ash, the bank returns as a ward. With no rebirth left, you may spend the bank once a fight as a heal when you fall below a quarter of your health.",
   "counters": [
    {"id": "ash_bank"},
    {"id": "ash_refused", "cap": 1}
   ],
   "records": [
    {
     "id": "eff:The Censer Remembers bank",
     "on": "pulse",
     "if": [{"read": "foe.debuff.fire", "op": ">=", "value": 1}],
     "do": [{"counter": {"id": "ash_bank", "add": 0.5}}]
    },
    {
     "id": "eff:The Censer Remembers leak",
     "on": "pulse",
     "if": [
      {"read": "foe.debuff.fire", "op": "==", "value": 0},
      {"read": "own.counter.ash_bank", "op": ">", "value": 0}
     ],
     "scale": {"read": "own.counter.ash_bank", "per": 1},
     "do": [{"counter": {"id": "ash_bank", "add": -0.02}}]
    },
    {
     "id": "eff:The Censer Remembers rise",
     "on": "refused",
     "if": [{"read": "own.counter.ash_bank", "op": ">", "value": 0}],
     "scale": {"read": "own.counter.ash_bank", "per": 1},
     "do": [{"ward_grow": {"share": 0.01, "of": "hp"}}]
    },
    {
     "id": "eff:The Censer Remembers mark refused",
     "on": "refused",
     "do": [
      {"counter": {"id": "ash_bank", "set": 0}},
      {"counter": {"id": "ash_refused", "set": 1}}
     ]
    },
    {
     "id": "eff:The Censer Remembers heal",
     "on": "wounded",
     "if": [
      {"read": "own.counter.ash_refused", "op": "==", "value": 0},
      {"read": "own.counter.ash_bank", "op": ">", "value": 0}
     ],
     "limit": {"per_fight": 1},
     "scale": {"read": "own.counter.ash_bank", "per": 1},
     "do": [{"heal": {"share": 0.01}}]
    },
    {
