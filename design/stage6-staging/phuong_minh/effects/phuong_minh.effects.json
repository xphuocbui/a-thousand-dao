  "Playing Past the Break": {
   "rule": "Shao Remnant Score (technique Effect, authored e4): Once a fight, firing Remnant Score's Next Movement right after its seventh attempts the eighth movement via a counted-chance meter (p = (thần hồn + khí vận) / 400). Success: 5 Slowed Time (5 s) on foe and +10 % linh lực. Failure: −10 % health and −10 % linh lực backlash. Restarts score at first either way.",
   "approx": "attaching this technique Effect and seeding build meters await pending words technique-effects and carried-meter; −10 % health backlash modelled as self_hit c=2.2 soul (~10 % HP on Kết Đan holders) and −10 % linh lực is guarded by own.qi_share >= 0.1 so pool does not go negative",
   "pending": "technique-effects: loader does not yet attach technique Effects or build meters; runs when supplied via tree_effects and meters",
   "counters": [{"id": "remnant_movement"}, {"id": "remnant_ready_8", "cap": 1}, {"id": "break_tried", "cap": 1}, {"id": "break_backlash", "cap": 1}],
   "records": [
    {
     "id": "eff:Playing Past the Break",
     "on": "art_fired",
     "filter": {"art_id": "remnant-next-movement"},
     "if": [
      {"read": "own.counter.remnant_ready_8", "op": "==", "value": 1},
      {"read": "own.counter.remnant_movement", "op": ">=", "value": 7},
      {"read": "own.counter.break_tried", "op": "==", "value": 0}
     ],
     "do": [
      {"counter": {"id": "break_tried", "set": 1}},
      {"counter": {"id": "remnant_ready_8", "set": 0}},
      {
       "meter": {
        "id": "playing_past_the_break",
        "success": [
         {"status": {"id": "slowed_time", "stacks": 5, "dur": 5, "side": "foe"}},
         {"gain_qi": {"share": 0.1}},
         {"counter": {"id": "remnant_movement", "set": 0}}
        ],
        "failure": [
         {"self_hit": {"c": 2.2, "dtype": "soul"}},
         {"counter": {"id": "break_backlash", "set": 1}},
         {"counter": {"id": "remnant_movement", "set": 0}}
        ]
       }
      }
     ]
    },
    {
     "id": "eff:Playing Past the Break reset",
     "on": "art_fired",
     "filter": {"art_id": "remnant-next-movement"},
     "if": [
      {"read": "own.counter.remnant_ready_8", "op": "==", "value": 1},
      {"read": "own.counter.remnant_movement", "op": ">=", "value": 7},
      {"read": "own.counter.break_tried", "op": ">=", "value": 1}
     ],
     "do": [
      {"counter": {"id": "remnant_ready_8", "set": 0}},
      {"counter": {"id": "remnant_movement", "set": 0}}
     ]
    },
    {
     "id": "eff:Playing Past the Break backlash qi",
     "on": "art_fired",
     "if": [
      {"read": "own.counter.break_backlash", "op": "==", "value": 1},
      {"read": "own.qi_share", "op": ">=", "value": 0.1}
     ],
     "do": [
      {"gain_qi": {"share": -0.1}},
      {"counter": {"id": "break_backlash", "set": 0}}
     ]
    },
    {
     "id": "eff:Playing Past the Break backlash clear",
     "on": "art_fired",
     "if": [{"read": "own.counter.break_backlash", "op": ">=", "value": 1}],
     "do": [{"counter": {"id": "break_backlash", "set": 0}}]
    },
    {
     "id": "eff:Playing Past the Break arm",
     "on": "art_fired",
     "filter": {"art_id": "remnant-next-movement"},
     "if": [{"read": "own.counter.remnant_movement", "op": ">=", "value": 7}],
     "do": [{"counter": {"id": "remnant_ready_8", "set": 1}}]
    },
    {
     "id": "eff:Playing Past the Break disarm",
     "on": "art_fired",
     "if": [
      {"read": "own.counter.remnant_movement", "op": "<", "value": 7},
      {"read": "own.counter.remnant_ready_8", "op": ">=", "value": 1}
     ],
     "do": [{"counter": {"id": "remnant_ready_8", "set": 0}}]
    }
   ]
  },
  "Eight of Nine": {
   "rule": "Tiêu Thiều Quản (pm-tieu-thieu-quan): Played as an art, each movement lays one Shao stack on the foe; a foe with eight stacks holds its arts: those that come ready in the next 2 s wait until the 2 s end. The ninth movement is not an art: while it plays, no hearer of lower realm can act against the player. Story use only.",
   "approx": "lays 1 Shao stack on fight start and stops the foe's clock for 2 s whenever foe Shao reaches 8 (cooldown 6 s); the ninth movement's lower-realm pacification is story-only",
   "records": [
    {
     "id": "eff:Eight of Nine open",
     "on": "fight_start",
     "do": [{"counter": {"id": "shao", "side": "foe", "add": 1}}]
    },
    {
     "id": "eff:Eight of Nine hold",
     "on": "art_fired",
     "if": [{"read": "foe.counter.shao", "op": ">=", "value": 8}],
     "limit": {"cooldown": 6},
     "do": [{"stop_clock": {"side": "foe", "seconds": 2.0}}]
    }
   ]
  },
