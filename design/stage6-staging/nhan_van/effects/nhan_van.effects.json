{
 "_doc": "Nhàn Vân Quán's Effect engine records (world-depth Stage 6; ADR-0009). Merged into assets/data/combat_effects.json under source world-depth:nhan_van by the serial step. Unpriced. Rule text from design/world/depth/sects/nhan_van.items.json.",
 "source": "world-depth:nhan_van",
 "effects": {
  "The Scroll Before the Painting": {
   "rule": "Plain Silk Scroll (Tố Quyên Quyển): while your reflection-double stands (double_up == 1), each pulse your stance ward loses a tenth of its peak when above half peak and gains 3 % of your maximum health, while the blank scroll records the growing ward (scroll_ward, decaying 10 % each pulse). When the double is gone and no set hands the ward over, the scroll is blank again.",
   "approx": "Stance-ward 10 %/s decay runs as -10 % of ward_peak on pulses while ward_of_peak >= 0.5 (exact 30 % max-HP equilibrium when unhit, while allowing rebuild after heavy hits); the scroll's own recorded ward counter (scroll_ward) decays by exact decay_share 0.1 each pulse.",
   "counters": [
    {
     "id": "double_t",
     "decay_per_pulse": 1
    },
    {
     "id": "double_up"
    },
    {
     "id": "scroll_ward",
     "decay_share": 0.1
    }
   ],
   "records": [
    {
     "id": "eff:The Scroll Before the Painting decay",
     "on": "pulse",
     "if": [
      {
       "read": "own.counter.double_up",
       "op": "==",
       "value": 1
      },
      {
       "read": "own.ward_of_peak",
       "op": ">=",
       "value": 0.5
      }
     ],
     "do": [
      {
       "ward_grow": {
        "share": -0.1,
        "of": "peak"
       }
      }
     ]
    },
    {
     "id": "eff:The Scroll Before the Painting grow",
     "on": "pulse",
     "if": [
      {
       "read": "own.counter.double_up",
       "op": "==",
       "value": 1
      }
     ],
     "do": [
      {
       "ward_grow": {
        "share": 0.03,
        "of": "hp"
       }
      },
      {
       "counter": {
        "id": "scroll_ward",
        "add": 3
       }
      }
     ]
    },
    {
     "id": "eff:The Scroll Before the Painting blank",
     "on": "pulse",
     "if": [
      {
       "read": "own.counter.double_up",
       "op": "==",
       "value": 0
      },
      {
       "read": "own.counter.scroll_ward",
       "op": ">",
       "value": 0
      }
     ],
     "do": [
      {
       "counter": {
        "id": "scroll_ward",
        "set": 0
       }
      }
     ]
    }
   ]
  },
  "Paint It Back": {
   "rule": "The Idle Cloud (Nhàn Vân Tam Bảo), full set (3 pieces): when your reflection-double falls (by timeout or ward break), the Plain Silk Scroll keeps the ward it grew (scroll_ward) and gives it to you as a stance ward; and the first time each fight your health falls to half or below, you regain 4 % + 3.5 % per hit taken in the last 3 s of your max health and 4 % + 4 % per art fired in the last 3 s of your max linh lực.",
   "approx": "Because engine own.lost_last.hp.3 / qi.3 return raw points rather than shares and heal/gain_qi scale on hp_max/qi_max or event.amount, the 3 s rewind restores 4 % + 3.5 % max HP per hit/tick received in the last 3 s (hits_3s) and 4 % + 4 % max linh lực per distinct art fired in the last 3 s (own.fired_within.3.all).",
