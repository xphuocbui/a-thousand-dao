  "Figure on the Clouds": {
   "rule": "Mother's Sky (Mẫu Thiên Song Bảo), full set (2 pieces): your reflection-double lasts 3 s longer; while it stands, your Water arts cost 10 % less; when it falls (by timeout or ward break), you gain 2 Water buff stacks for 10 s.",
   "counters": [
    {
     "id": "double_t",
     "decay_per_pulse": 1
    },
    {
     "id": "double_up"
    }
   ],
   "records": [
    {
     "id": "eff:Figure on the Clouds extend",
     "on": "art_fired",
     "filter": {
      "art_id": "cloud-in-the-pool"
     },
     "do": [
      {
       "counter": {
        "id": "double_t",
        "add": 3
