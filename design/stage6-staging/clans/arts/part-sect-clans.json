      }
    ],
    "effects": [
      {
        "id": "art:shade-of-the-road:cast",
        "on": "art_fired",
        "filter": {
          "art_id": "shade-of-the-road"
        },
        "do": [
          {
            "ward_grow": {
              "share": 0.05,
              "of": "hp"
            }
          },
          {
            "counter": {
              "id": "road_shade",
              "set": 5
            }
          }
        ]
      },
      {
        "id": "art:shade-of-the-road:pulse",
        "on": "pulse",
        "if": [
          {
            "read": "own.counter.road_shade",
            "op": ">=",
            "value": 1
          },
          {
            "read": "own.composed",
            "op": ">=",
            "value": 1
          }
        ],
        "do": [
          {
            "ward_grow": {
              "share": 0.02,
              "of": "hp"
            }
          },
          {
            "counter": {
              "id": "road_shade",
              "add": -1
            }
          }
        ]
      }
    ],
    "rule": "Raises a Water ward of 5% max HP and thickens it by +2% max HP on each pulse (up to 5 pulses) while you remain Composed.",
    "hooks": [
      "ward",
      "composed"
    ],
    "sources": [
      "world-depth:clans"
    ],
    "notes": "locust-shade-breathing suite L2 art; uses counter rather than stance slot so it stacks safely with other stances."
