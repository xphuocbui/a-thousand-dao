  {
    "id": "pillar-in-the-current",
    "name": "Pillar in the Current (Trụ Lập Lưu)",
    "element": "earth",
    "role": "ward",
    "tier": "authored",
    "group": "twin-span-pillar-method",
    "tags": [
      "earth",
      "stance"
    ],
    "c_art": 0.0,
    "cost_share": 0.03,
    "cooldown": 6.0,
    "kind": "elem",
    "buff": [
      1,
      8.0
    ],
    "power": "engine",
    "states": [
      {
        "id": "pillar-in-current",
        "tags": [
          "composed"
        ],
        "mods": {
          "block": 40
        }
      }
    ],
    "counters": [
      {
        "id": "pillar_hits",
        "start": 0,
        "cap": 3
      }
    ],
    "guards": [
      {
        "read": "own.state.pillar-in-current",
        "op": "<",
        "value": 1
      }
    ],
    "effects": [
      {
        "id": "art:pillar-in-the-current:enter",
        "on": "art_fired",
        "filter": {
          "art_id": "pillar-in-the-current"
        },
        "do": [
          {
            "state": {
              "set": "pillar-in-current"
            }
          },
          {
            "counter": {
              "id": "pillar_hits",
              "set": 3
            }
          }
        ]
      },
      {
        "id": "art:pillar-in-the-current:push",
        "on": "was_hit",
        "if": [
          {
            "read": "own.state.pillar-in-current",
            "op": "==",
            "value": 1
          },
          {
            "read": "own.counter.pillar_hits",
            "op": ">=",
            "value": 1
          }
        ],
        "do": [
          {
            "timer": {
              "side": "foe",
              "which": "next",
              "by": 0.5
            }
          },
          {
            "counter": {
              "id": "pillar_hits",
              "add": -1
            }
          }
        ]
      },
      {
        "id": "art:pillar-in-the-current:exit",
        "on": "was_hit",
        "if": [
          {
            "read": "own.state.pillar-in-current",
            "op": "==",
            "value": 1
          },
          {
            "read": "own.counter.pillar_hits",
            "op": "<=",
            "value": 0
          }
        ],
        "do": [
          {
            "state": {
              "set": null
            }
          }
        ]
      }
    ],
    "rule": "Enters Pillar in Current (+40 Block Rating, counts as Composed). On the next 3 hits received, delays the foe's next ready art by 0.5 s and ends the stance after the 3rd hit.",
    "hooks": [
      "stance",
      "composed",
      "block",
      "timer delay"
    ],
    "sources": [
      "world-depth:clans"
    ],
    "notes": "twin-span-pillar-method suite L1 art; non-spatial pushback rendered as next-art delay."
  },
