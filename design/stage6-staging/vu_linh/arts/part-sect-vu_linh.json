[
 {
  "id": "bank-the-kiln-stance",
  "name": "Bank the Kiln (Ủ Lò)",
  "element": "fire",
  "role": "utility",
  "tier": "authored",
  "power": "engine",
  "group": "charcoal-burners-primer",
  "tags": ["fire", "stance"],
  "c_art": 0.0,
  "cost_share": 0.03,
  "cooldown": 5.0,
  "kind": "elem",
  "counters": [
   {"id": "kiln_ember", "cap": 1}
  ],
  "states": [
   {"id": "kiln-banked", "tags": ["composed"], "mods": {}}
  ],
  "effects": [
   {
    "id": "kiln-banked-regen",
    "on": "always",
    "if": [
     {"read": "own.state.kiln-banked", "op": ">=", "value": 1},
     {"read": "own.composed", "op": ">=", "value": 1}
    ],
    "do": [
     {"mod": {"regen": 0.007}}
    ]
   },
   {
    "id": "kiln-leave-ember",
    "on": "art_fired",
    "filter": {"art_id": "bank-the-kiln-stance"},
    "if": [
     {"read": "own.state.kiln-banked", "op": ">=", "value": 1}
    ],
    "do": [
     {"counter": {"id": "kiln_ember", "set": 1}}
    ]
   },
   {
    "id": "kiln-toggle",
    "on": "art_fired",
    "filter": {"art_id": "bank-the-kiln-stance"},
    "do": [
     {"state": {"set": "kiln-banked", "toggle": true}}
    ]
   },
   {
    "id": "kiln-fire-boost",
    "on": "art_fired",
    "filter": {"element": "fire", "not_art_id": "bank-the-kiln-stance"},
    "if": [
     {"read": "own.counter.kiln_ember", "op": ">=", "value": 1}
    ],
    "do": [
     {"mod": {"dmg_more": 0.30, "kind": "art", "element": "fire"}},
     {"counter": {"id": "kiln_ember", "set": 0}}
    ]
   }
  ],
  "rule": "A Composed stance: while you hold it and stay Composed, your linh lực regenerates faster (+0.7 pp/s). Toggling out of the stance arms your next Fire art for 30 % more damage.",
  "hooks": ["composed", "linh lực regen", "fire damage"],
  "notes": "Named bank-the-kiln-stance to avoid collision with phan_vu's bank-the-kiln.",
  "sources": ["world-depth:vu_linh"]
 },
 {
  "id": "hang-a-bell",
