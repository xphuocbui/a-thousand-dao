  "element": "wood",
  "role": "utility",
  "tier": "authored",
  "power": "engine",
  "group": "canopy-bell-canon",
  "tags": ["wood", "bell", "formation"],
  "c_art": 0.0,
  "cost_share": 0.04,
  "cooldown": 5.0,
  "kind": "elem",
  "counters": [
   {"id": "canopy_bell", "upkeep": {"pool": "qi", "per_stack": 0.003}}
  ],
  "effects": [
   {
    "id": "hang-bell-add",
    "on": "art_fired",
    "filter": {"art_id": "hang-a-bell"},
    "do": [
     {"counter": {"id": "canopy_bell", "add": 1}}
    ]
   },
   {
    "id": "hang-bell-mods",
    "on": "always",
    "if": [
     {"read": "own.counter.canopy_bell", "op": ">=", "value": 1}
    ],
    "scale": {"read": "own.counter.canopy_bell", "per": 1},
    "do": [
     {"mod": {"evade": 3, "acc": 4}}
    ]
   }
  ],
  "rule": "Hangs a Canopy Bell charge for the fight: each bell gives +3 pp evade and +4 accuracy, and costs 0.6 % of maximum linh lực per second in upkeep (bells you cannot pay fall).",
  "hooks": ["bell charges", "evade", "accuracy", "upkeep"],
  "notes": "Uses counter canopy_bell with pulse upkeep (0.006 qi/s per bell) to bound bell count without a hard cap; +4 acc represents revealing the unseen foe in 1v1 duels.",
  "sources": ["world-depth:vu_linh"]
 },
