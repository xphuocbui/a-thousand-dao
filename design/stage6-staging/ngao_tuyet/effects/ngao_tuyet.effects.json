     "scale": {
      "read": "own.counter.plum_petal",
      "per": 1
     },
     "do": [
      {
       "stacks": {
        "el": "wood",
        "n": 2,
        "for": 8,
        "side": "foe"
       }
      },
      {
       "counter": {
        "id": "plum_petal",
        "set": 0
       }
      }
     ]
    }
   ]
  },
  "The Tiger's Weight": {
   "rule": "Hide of the Thạch Khẩu Tiger: beasts of Luyện Khí and Trúc Cơ strength hesitate before attacking the wearer: their first attack each fight is delayed by 1 s (applied to non-boss duel foes in combat).",
   "approx": "Neither fight engine exposes foe.creature or foe.realm; gates on foe.boss == 0 and delays the foe's opening clock by 1.0 s via stop_clock at fight_start.",
   "records": [
    {
     "id": "eff:The Tiger's Weight",
     "on": "fight_start",
     "if": [
      {
       "read": "foe.boss",
       "op": "==",
       "value": 0
      }
     ],
     "do": [
      {
       "stop_clock": {
        "side": "foe",
        "seconds": 1.0
       }
      }
     ]
    }
   ]
  },
  "Bare Branch Blooms": {
   "rule": "Plum and Snow, full set (2 pieces): while you fight with no companion and are below half health, each Petal you hold adds 6 % sword critical damage; when Last Blossom saves you, you gain 5 Petals.",
   "approx": "No live own.companions readable exists; has_companion latches on kind: companion hit/evade while own.since.flying-sword >= 12 so the canon's own Flying Sword summon does not disable the set.",
   "counters": [
    {
     "id": "plum_petal",
     "each_for": 12
    },
    {
     "id": "has_companion",
     "cap": 1
    },
    {
     "id": "last_blossom_saved",
     "cap": 1
    }
   ],
   "records": [
    {
