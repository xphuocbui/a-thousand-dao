[
 {
  "id": "first-petal",
  "name": "First Petal (Sơ Biện)",
  "element": "metal",
  "role": "damage",
  "tier": "authored",
  "power": "engine",
  "group": "cold-plum-sword-primer",
  "tags": ["metal", "sword", "quick"],
  "c_art": 1.3,
  "cost_share": 0.02,
  "cooldown": 1.5,
  "kind": "phys",
  "counters": [
   {"id": "plum_petal", "each_for": 12},
   {"id": "first_petal_ready", "cap": 1}
  ],
  "effects": [
   {
    "id": "first-petal-arm",
    "on": "art_fired",
    "filter": {"tags": ["sword"]},
    "if": [{"read": "own.counter.plum_petal", "op": ">=", "value": 5}],
    "do": [{"counter": {"id": "first_petal_ready", "set": 1}}]
   },
   {
    "id": "first-petal-disarm",
    "on": "art_fired",
    "filter": {"tags": ["sword"]},
    "if": [{"read": "own.counter.plum_petal", "op": "<", "value": 5}],
    "do": [{"counter": {"id": "first_petal_ready", "set": 0}}]
   },
   {
    "id": "first-petal-gain",
    "on": "hit_landed",
    "filter": {"art_id": "first-petal"},
    "do": [{"counter": {"id": "plum_petal", "add": 1}}]
   },
   {
    "id": "first-petal-crit",
    "on": "always",
    "if": [
     {"read": "own.counter.first_petal_ready", "op": ">=", "value": 1},
     {"read": "own.counter.plum_petal", "op": ">=", "value": 5}
    ],
    "do": [{"mod": {"sure_crit": 1, "tags": ["sword"]}}]
   },
   {
    "id": "first-petal-spend",
    "on": "crit",
    "filter": {"tags": ["sword"]},
    "if": [
     {"read": "own.counter.first_petal_ready", "op": ">=", "value": 1},
     {"read": "own.counter.plum_petal", "op": ">=", "value": 5}
    ],
    "do": [
     {"counter": {"id": "plum_petal", "add": -5}},
     {"counter": {"id": "first_petal_ready", "set": 0}}
    ]
   }
  ],
  "rule": "A fast Metal thrust that grants 1 Petal stack (each lasting 12 s) when it lands; while you hold 5 or more Petals, your next sword thrust is a guaranteed critical hit and spends 5 Petals.",
  "hooks": ["metal", "sword", "crit", "petal counter", "quick arts"],
  "sources": ["world-depth:ngao_tuyet"]
 },
