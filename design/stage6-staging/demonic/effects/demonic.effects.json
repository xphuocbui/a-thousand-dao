              "status": {
                "id": "sleep",
                "stacks": 1,
                "dur": 3
              }
            }
          ]
        }
      ]
    },
    "Writ in Their Blood": {
      "rule": "The Blood-Ink Study, full set (3 pieces): Your Blood-Ink Writs may be written in a foe's blood mid-fight: each writ that lands on a foe who is bleeding is free, and the next writ you cast carries its stolen qi (+20 % damage).",
      "source": "world-depth:demonic",
      "approx": "blood-ink-writ hitting a Bleeding foe refunds its paid linh lực cost via refund {share: 1.0} and restores its 0.03 hp_cost via heal {share: 0.03, ignore_taken: true}, then arms stolen_writ, spent on the next blood-ink-writ art_fired for +20 % damage (dmg_more 0.20, 0.1 s seal tag window).",
      "counters": [
        {
          "id": "stolen_writ",
          "cap": 1
        }
