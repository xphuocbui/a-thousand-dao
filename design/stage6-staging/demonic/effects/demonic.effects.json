{
  "_doc": "Stage 6 Effects for demonic: 2 technique effects, 10 item effects, 3 set 3pc effects.",
  "source": "world-depth:demonic",
  "effects": {
    "The Black Under the White": {
      "rule": "Black Ice Method (layer 1): Every 5 of your Ice stacks on a foe count as one of your curses wherever a rule counts your curses or the foe's different statuses. It is a count only: it takes no curse slot and is not cleansed as a curse.",
      "source": "world-depth:demonic",
      "records": [
        {
          "id": "eff:The Black Under the White",
          "on": "always",
          "do": [
            {
              "mod": {
                "counted_curse_per": 5,
                "element": "ice"
              }
            }
          ]
        }
      ]
    },
    "Black Thaw": {
      "rule": "Black Ice Method (layer 1): When one of your Ice batches on a foe runs out while that foe carries one of your curses, the frost lets go black: the foe takes a Chaos hit of 0.1 per stack the batch held.",
      "source": "world-depth:demonic",
      "records": [
        {
          "id": "eff:Black Thaw",
          "on": "batch_ended",
          "filter": {
            "element": "ice"
          },
          "if": [
            {
              "read": "foe.curses",
              "op": ">=",
              "value": 1
            }
          ],
          "scale": {
            "read": "event.stacks",
            "per": 1
          },
          "do": [
            {
              "free_hit": {
                "c": 0.1,
                "dtype": "chaos"
              }
            }
          ]
        }
      ]
    },
    "The Robe Drinks First": {
      "rule": "The Blood-Red Robe (dm-blood-red-robe): The first time each fight you take a hit that would drop you below half health, the robe drinks the blood instead: that hit's damage is halved, and the robe's red deepens until the fight ends (+10 % leech while it lasts).",
      "source": "world-depth:demonic",
      "approx": "was_hit fires once own.hp_share < 0.5, restoring half of event.amount via heal {of: \"amount\", share: 0.5} (if the hit leaves own HP > 0) and latching robe_deepened for +10 leech_hp.",
      "counters": [
        {
          "id": "robe_deepened",
          "cap": 1
        }
      ],
      "records": [
        {
          "id": "eff:The Robe Drinks First save",
          "on": "was_hit",
          "limit": {
            "per_fight": 1
          },
          "if": [
            {
              "read": "own.hp_share",
              "op": "<",
              "value": 0.5
            },
            {
              "read": "event.amount",
              "op": ">",
              "value": 0
            }
          ],
          "do": [
            {
              "heal": {
                "of": "amount",
                "share": 0.5
              }
            },
            {
              "counter": {
                "id": "robe_deepened",
                "set": 1
              }
            }
          ]
        },
        {
          "id": "eff:The Robe Drinks First leech",
          "on": "always",
          "if": [
            {
              "read": "own.counter.robe_deepened",
              "op": ">=",
              "value": 1
            }
          ],
          "do": [
            {
              "mod": {
                "leech_hp": 10
              }
            }
          ]
        }
      ]
    },
    "Draw the Ink": {
      "rule": "The Ink-Drawing Needle (dm-ink-needle): A foe struck by the needle bleeds one drop of ink: your next Blood-Ink Writ against that foe lasts twice as long and costs no health.",
      "source": "world-depth:demonic",
      "approx": "Armed by any hit_landed (single-foe duel), waives blood-ink-writ's hp_cost via hp_cost_red 1.0 (art_id blood-ink-writ), and spends ink_drawn on blood-ink-writ art_fired for +100 % status_dur (0.1 s window on kind curse; curses clamp to curse_duration_max = 5 s).",
      "counters": [
        {
          "id": "ink_drawn",
          "cap": 1
        }
      ],
      "records": [
        {
          "id": "eff:Draw the Ink arm",
          "on": "hit_landed",
          "if": [
            {
              "read": "own.counter.ink_drawn",
              "op": "==",
              "value": 0
            }
          ],
          "do": [
            {
              "counter": {
                "id": "ink_drawn",
                "add": 1
              }
            }
          ]
        },
        {
          "id": "eff:Draw the Ink no_hp",
          "on": "always",
          "if": [
            {
              "read": "own.counter.ink_drawn",
              "op": ">=",
              "value": 1
            }
          ],
          "do": [
            {
              "mod": {
                "hp_cost_red": 1.0,
                "art_id": "blood-ink-writ"
              }
            }
          ]
        },
        {
          "id": "eff:Draw the Ink spend",
          "on": "art_fired",
          "filter": {
            "art_id": "blood-ink-writ"
          },
          "if": [
            {
              "read": "own.counter.ink_drawn",
              "op": ">=",
              "value": 1
            }
          ],
          "do": [
            {
              "counter": {
                "id": "ink_drawn",
                "set": 0
              }
            },
            {
              "mod": {
                "status_dur": 100,
                "kind": "curse",
                "for": 0.1
              }
            }
          ]
        }
      ]
    },
    "Sealed in His Name": {
      "rule": "The Blood-Ink Seal of Mặc (dm-blood-seal): A writ stamped with the seal cannot be broken by anyone of a lower realm than the stamper; it lifts only when the stamper dies or stamps it again.",
      "source": "world-depth:demonic",
      "approx": "No cleanse-immunity vs lower-realm flag exists on foe statuses, so blood-ink-writ art_fired grants curse_fast 1 (unbreakable by cleanses across all realms) and +100 status_dur (0.1 s window on kind curse, clamped at curse_duration_max = 5 s).",
      "records": [
        {
          "id": "eff:Sealed in His Name",
          "on": "art_fired",
          "filter": {
            "art_id": "blood-ink-writ"
          },
          "do": [
            {
              "mod": {
                "status_dur": 100,
                "curse_fast": 1,
                "kind": "curse",
                "for": 0.1
              }
            }
          ]
        }
      ]
    },
    "The Held Voice": {
      "rule": "The Cracked Bell of Đồng Sơn (dm-cracked-bell, authored b2): The bell holds one soul thread. Ringing it once in a fight releases the thread: your next soul art deals +60 % damage and the thread is gone for good.",
      "source": "world-depth:demonic",
      "approx": "Permanent consumption across campaign saves is outside a duel; inside each fight, starts with 1 held_voice granting +60 x_soul on soul arts until consumed after the first soul_hit.",
      "counters": [
        {
          "id": "held_voice",
          "cap": 1
        }
      ],
      "records": [
        {
          "id": "eff:The Held Voice start",
          "on": "fight_start",
          "do": [
            {
              "counter": {
                "id": "held_voice",
                "set": 1
              }
            }
          ]
        },
        {
          "id": "eff:The Held Voice bonus",
          "on": "always",
          "if": [
            {
              "read": "own.counter.held_voice",
              "op": ">=",
              "value": 1
            }
          ],
          "do": [
            {
              "mod": {
                "x_soul": 60,
                "tags": [
                  "soul"
                ]
              }
            }
          ]
        },
        {
          "id": "eff:The Held Voice spend",
          "on": "soul_hit",
          "limit": {
            "per_fight": 1
          },
          "if": [
            {
              "read": "own.counter.held_voice",
              "op": ">=",
              "value": 1
            }
          ],
          "do": [
            {
              "counter": {
                "id": "held_voice",
                "set": 0
              }
            }
          ]
        }
      ]
    },
    "Nine Wicks": {
      "rule": "Lamp of Borrowed Wicks (dm-borrowed-wick-lamp): The lamp burns every soul thread you carry, one to a wick, and each lit wick reserves 1 % of your linh lực. While it holds at least one, you cannot be reduced below 1 health by a soul art; each time this saves you, one wick goes out.",
      "source": "world-depth:demonic",
      "reserve": 0.09,
      "approx": "Starts at 9 lit wicks (reserve 0.09). Arms last_hit_soul only when an unreflected soul_taken drops own.hp_share <= 0 so refuse_down (engine limit 1 save per fight, leaving 1 HP) triggers only on a lethal soul art, consuming 1 wick and restoring 1 % linh lực.",
      "counters": [
        {
          "id": "wick_charges"
        },
        {
          "id": "last_hit_soul",
          "cap": 1
        }
      ],
      "records": [
        {
          "id": "eff:Nine Wicks start",
          "on": "fight_start",
          "do": [
            {
              "counter": {
                "id": "wick_charges",
                "set": 9
              }
            }
          ]
        },
        {
          "id": "eff:Nine Wicks soul mark",
          "on": "soul_taken",
          "if": [
            {
              "read": "own.hp_share",
              "op": "<=",
              "value": 0
            },
            {
              "read": "event.reflected",
              "op": "==",
              "value": 0
            }
          ],
          "do": [
            {
              "counter": {
                "id": "last_hit_soul",
                "set": 1
              }
            }
          ]
        },
        {
          "id": "eff:Nine Wicks save",
          "on": "down",
          "if": [
            {
              "read": "own.counter.wick_charges",
              "op": ">=",
              "value": 1
            },
            {
              "read": "own.counter.last_hit_soul",
              "op": ">=",
              "value": 1
            }
          ],
          "do": [
            {
              "refuse_down": {}
            },
            {
              "counter": {
                "id": "last_hit_soul",
                "set": 0
              }
            },
            {
              "counter": {
                "id": "wick_charges",
                "add": -1
              }
            },
            {
              "gain_qi": {
                "share": 0.01
              }
            }
          ]
        }
      ]
    },
    "Drink from the Dark": {
      "rule": "Cave Orchid Pendant (dm-cave-orchid-pendant): While a Darkness art of yours holds (a field you laid, or a Darkness curse you carry on the foe), your linh lực regenerates from the dark instead of from you: double regeneration, and no dream-qi is taken from anyone nearby.",
      "source": "world-depth:demonic",
      "approx": "No dream-qi harvest clause is out-of-fight flavour; while own.field_up >= 1 or foe.curses >= 1, adds +0.035 regen (matching base 0.035 regeneration).",
      "records": [
        {
          "id": "eff:Drink from the Dark",
          "on": "pulse",
          "if": [
            {
              "any": [
                {
                  "read": "own.field_up",
                  "op": ">=",
                  "value": 1
                },
                {
                  "read": "foe.curses",
                  "op": ">=",
                  "value": 1
                }
              ]
            }
          ],
          "do": [
            {
              "mod": {
                "regen": 0.035,
                "for": 1.1
              }
            }
          ]
        }
      ]
    },
    "Within a Breath": {
      "rule": "Black Wind Sabre (dm-black-wind-sabre): Leech from this sabre is doubled in the first second after a critical hit and does nothing against a foe already below 10 % health.",
