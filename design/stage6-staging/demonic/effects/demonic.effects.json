    "His Sister's Water": {
      "rule": "The Bitter Well Gourd (dm-bitter-well-gourd): Once per fight, drink: restore 30 % linh lực, and for 5 seconds no one can drain linh lực from you.",
      "source": "world-depth:demonic",
      "approx": "Triggers once per fight on pulse below 70 % linh lực to restore 30 % linh lực and raise a 5 s gourd_ward counter; because defend/drain has no foe drain-immunity key and burn_qi emits qi_drained on the drainer rather than the victim, incoming drain-tagged hits (was_hit filter tags drain) during those 5 s trigger an immediate +0.02 linh lực counter-restore.",
      "counters": [
        {
          "id": "gourd_ward",
          "cap": 1,
          "each_for": 5
        }
      ],
      "records": [
        {
          "id": "eff:His Sister's Water drink",
          "on": "pulse",
          "limit": {
            "per_fight": 1
          },
          "if": [
            {
              "read": "own.qi_share",
              "op": "<",
              "value": 0.7
            }
          ],
          "do": [
            {
              "gain_qi": {
                "share": 0.3
              }
            },
            {
              "counter": {
                "id": "gourd_ward",
                "add": 1
              }
            }
          ]
        },
        {
          "id": "eff:His Sister's Water ward",
          "on": "was_hit",
          "filter": {
            "tags": [
              "drain"
            ]
          },
          "if": [
            {
              "read": "own.counter.gourd_ward",
              "op": ">=",
              "value": 1
            }
          ],
          "do": [
            {
              "gain_qi": {
                "share": 0.02
              }
            }
          ]
        }
      ]
    },
    "Fed in Blood": {
      "rule": "A Mother's Lamp (dm-sons-lamp): The lamp burns only on its holder's blood: each season it costs health that does not come back until it is put out. While it burns it speaks in the voice it holds, and that voice is changing.",
      "source": "world-depth:demonic",
      "not_run": "out-of-fight seasonal upkeep and narrative hook: its seasonal health cost occurs between seasons, not inside a duel",
      "records": []
    },
    "Lullaby of the Karst": {
      "rule": "Lamp of the Karst Children (dm-karst-lamp, authored d40): When your art lays Slowed Time on a foe that carries your Withering, it falls Asleep.",
