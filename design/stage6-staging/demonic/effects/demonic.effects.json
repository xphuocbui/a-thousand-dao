            {
              "heal": {
                "share": 0.03,
                "ignore_taken": true
              }
            },
            {
              "counter": {
                "id": "stolen_writ",
                "set": 1
              }
            }
          ]
        },
        {
          "id": "eff:Writ in Their Blood empower",
