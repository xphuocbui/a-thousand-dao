[
 {
  "id": "wet-ink",
  "name": "Wet Ink (Thấp Mặc)",
  "element": "wood",
  "role": "control",
  "tier": "authored",
  "power": "engine",
  "group": "ink-grinding-breath",
  "tags": ["talisman", "seal"],
  "c_art": 1.5,
  "cost_share": 0.03,
  "cooldown": 4.0,
  "kind": "elem",
  "counters": [
   {"id": "wet_ink_strikes", "cap": 3},
   {"id": "ink_marked", "cap": 1, "each_for": 6}
  ],
  "effects": [
   {
    "id": "wet-ink-prime",
    "on": "art_fired",
    "filter": {"art_id": "wet-ink"},
    "do": [
     {"counter": {"id": "wet_ink_strikes", "set": 3}}
    ]
   },
   {
    "id": "wet-ink-mark",
    "on": "hit_landed",
    "if": [
     {"read": "own.counter.wet_ink_strikes", "op": ">=", "value": 1}
    ],
    "do": [
     {"counter": {"id": "wet_ink_strikes", "add": -1}},
     {"counter": {"id": "ink_marked", "add": 1}},
     {"status": {"id": "slowed_time", "stacks": 1, "dur": 2, "side": "foe"}}
    ]
   },
   {
    "id": "wet-ink-home",
    "on": "always",
    "if": [
     {"read": "own.counter.ink_marked", "op": ">=", "value": 1}
    ],
    "do": [
     {"mod": {"acc": 20, "tags": ["talisman"]}}
    ]
   }
  ],
  "rule": "An ink-wet talisman strike that primes your hand: your next three direct hits (this strike included) leave an ink mark on the foe for 6 s and apply 1 Slowed Time stack for 2 s. While the ink mark lasts, your talismans gain +20 accuracy points.",
  "hooks": ["talisman", "slowed time", "accuracy", "ink mark"],
  "sources": ["world-depth:hoa_tinh"]
 },
 {
  "id": "seven-star-talisman",
  "name": "Seven-Star Talisman (Thất Tinh Phù)",
  "element": "wood",
  "role": "damage",
  "tier": "authored",
  "power": "engine",
  "group": "painted-dipper-canon",
  "tags": ["talisman"],
  "c_art": 1.4,
  "cost_share": 0.03,
  "cooldown": 2.5,
  "kind": "elem",
  "debuff": [1, 10],
  "counters": [
   {"id": "dipper_star"},
   {"id": "dipper_star_ttl", "cap": 12},
   {"id": "dipper_locked", "cap": 1},
   {"id": "rainfast_ink_on", "cap": 1},
   {"id": "rain_hold", "cap": 8},
   {"id": "seven_stars_fast", "cap": 8}
  ],
  "effects": [
   {
    "id": "dipper-paint",
    "on": "hit_landed",
    "filter": {"art_id": "seven-star-talisman"},
    "do": [
     {"counter": {"id": "dipper_star", "add": 1}},
     {"counter": {"id": "dipper_star_ttl", "set": 12}}
    ]
   },
   {
    "id": "dipper-paint-lock",
    "on": "hit_landed",
    "filter": {"art_id": "seven-star-talisman"},
    "if": [
     {
      "any": [
       {"read": "own.counter.rain_hold", "op": ">=", "value": 1},
       {"read": "own.counter.rainfast_ink_on", "op": ">=", "value": 1},
       {"read": "own.counter.seven_stars_fast", "op": ">=", "value": 1}
      ]
     }
    ],
    "do": [
     {"counter": {"id": "dipper_locked", "set": 1}}
    ]
   },
   {
    "id": "dipper-detonate",
    "on": "hit_landed",
    "filter": {"art_id": "seven-star-talisman"},
    "if": [
     {"read": "own.counter.dipper_star", "op": ">=", "value": 7}
    ],
    "do": [
     {"free_hit": {"c": 2.8, "dtype": "chaos"}},
     {"counter": {"id": "dipper_star", "set": 0}},
     {"counter": {"id": "dipper_star_ttl", "set": 0}},
     {"counter": {"id": "dipper_locked", "set": 0}}
    ]
   },
   {
    "id": "dipper-tick",
    "on": "pulse",
    "if": [
     {"read": "own.counter.dipper_star_ttl", "op": ">=", "value": 1}
    ],
    "do": [
     {"counter": {"id": "dipper_star_ttl", "add": -1}}
    ]
   },
   {
    "id": "dipper-expire",
    "on": "pulse",
    "if": [
     {"read": "own.counter.dipper_star_ttl", "op": "==", "value": 0},
     {"read": "own.counter.dipper_star", "op": ">=", "value": 1}
    ],
    "do": [
     {"counter": {"id": "dipper_star", "set": 0}},
     {"counter": {"id": "dipper_locked", "set": 0}}
    ]
   },
   {
    "id": "dipper-wiped",
    "on": "cleansed",
    "if": [
     {"read": "own.counter.dipper_star", "op": ">=", "value": 1},
     {"read": "own.counter.dipper_locked", "op": "==", "value": 0},
     {"read": "own.counter.rainfast_ink_on", "op": "==", "value": 0},
     {"read": "own.counter.rain_hold", "op": "==", "value": 0},
     {"read": "own.counter.seven_stars_fast", "op": "==", "value": 0}
    ],
    "do": [
     {"counter": {"id": "dipper_star", "set": 0}},
     {"counter": {"id": "dipper_star_ttl", "set": 0}}
    ]
   }
  ],
  "rule": "Throws a talisman that deals Wood (Chaos) damage, lays 1 Wood debuff stack for 10 s, and paints one star on the foe for 12 s (each star refreshes the 12 s window). A foe's cleanse wipes the stars unless they were painted while The Rain Does Not Take It, Rainfast Ink, or Seven Stars in One Stroke holds. On the seventh star, the whole figure detonates for a 2.8 Chaos burst and clears the stars.",
  "hooks": ["wood stacks", "talisman", "counted stars", "trigger damage", "rainfast"],
  "sources": ["world-depth:hoa_tinh", "d22 stars-on-the-foe"]
 },
 {
