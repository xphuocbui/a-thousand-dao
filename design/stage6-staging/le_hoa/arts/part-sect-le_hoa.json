 {"id": "bar-the-gate", "name": "Bar the Gate (Bế Môn)", "element": "metal", "role": "ward", "tier": "authored", "power": "engine", "group": "gate-sword-primer", "tags": ["physical", "sword", "ward"], "c_art": 0.0, "cost_share": 0.03, "cooldown": 4.0, "kind": "phys", "counters": [{"id": "gate_raised", "decay_per_pulse": 1}, {"id": "gate_guard"}], "effects": [{"id": "bar-gate-raise", "on": "art_fired", "filter": {"art_id": "bar-the-gate"}, "do": [{"counter": {"id": "gate_raised", "set": 5}}, {"counter": {"id": "gate_guard", "set": 1}}]}, {"id": "bar-gate-halve", "on": "always", "if": [{"read": "own.counter.gate_raised", "op": ">=", "value": 1}, {"read": "own.counter.gate_guard", "op": ">=", "value": 1}, {"read": "own.composed", "op": ">=", "value": 1}], "do": [{"mod": {"dampen_taken": 100}}]}, {"id": "bar-gate-riposte", "on": "was_hit", "if": [{"read": "own.counter.gate_raised", "op": ">=", "value": 1}, {"read": "own.counter.gate_guard", "op": ">=", "value": 1}, {"read": "own.composed", "op": ">=", "value": 1}], "do": [{"counter": {"id": "gate_guard", "set": 0}}, {"free_hit": {"c": 0.65, "dtype": "phys"}}, {"stacks": {"el": "metal", "n": 1, "for": 6, "side": "foe"}}]}], "rule": "Raises the gate sword for 4 s (5 initial gate_raised -> 4 pulses after pulse-start decay, leaving Deep Winter intact) and arms 1 guard. While Composed with the sword raised, the next hit on you is halved (dampen_taken 100) and the striker takes a light Physical Metal counter-hit (0.65 c) and 1 Metal stack for 6 s.", "hooks": ["composed", "damage taken", "free hits", "metal stacks"], "sources": ["world-depth:le_hoa"]},
